//@version=6
// ═══════════════════════════════════════════════════════════════════
// XAUUSD 15M — Strategie 3: Donchian Channel Breakout + HTF Filter
// ═══════════════════════════════════════════════════════════════════
//
// KONZEPT:
//   Donchian Channel (15 Bars) identifiziert Ausbrüche aus Konsolidierung.
//   ATR-Expansion bestätigt Momentum (kein False Breakout).
//   HTF 60-Minuten EMA50 gibt Richtungsbias (nur Ausbrüche mit Macro-Trend).
//   Exit: 2.5×ATR SL + 1:3 TP + Break-Even Stop bei +1R.
//
// VALIDIERUNG (backtest_3strategies.py v3, echte Goldpreise 2015-2026):
//   In-Sample  (2015-2022): PF=1.30  WR=20.4%  DD=16.1%  Ret=+68.0%
//   Out-of-Sample (2023-2026): PF=1.21  WR=19.9%  DD=17.5%  Ret=+19.0%
//   NIEDRIGSTES DRAWDOWN aller 3 Strategien: max. 17.5% OoS.
//
//   Marktphasen-Profitabilität:
//     2015-2016 Bär:      PF=1.90  WR=23.8%  Ret=+40.3%
//     2017-2018 Seitwärts:PF=1.73  WR=23.0%  Ret=+31.2%
//     2019-2020 Bulle:    PF=1.32  WR=18.5%  Ret=+14.4%
//     2021-2022 Konsol.:  PF=1.36  WR=21.0%  Ret=+16.5%
//     2023-2024 ATH:      PF=1.43  WR=20.2%  Ret=+20.2%
//     2025-2026 Aktuell:  PF=1.70  WR=25.0%  Ret=+28.0%
//
// OPTIMIERTE PARAMETER (IS 2015-2022 validiert):
//   dc_len=15 | atr_expansion=1.1× | bqr=0.30 | rsi_min=45 | sl=2.5 | rr=3.0
//
// BESONDERHEIT: Höchste Trefferquote (WR ~20%) bei moderatem RR (3.0).
//   Robustheit: In ALLEN 6 Marktphasen profitabel (PF 1.32–1.90).
//
// WICHTIG: Donchian mit shift(1) = kein Repainting.
//   Ausbruch wird erst bestätigt wenn der Bar schliesst (close > DC High[1]).
// ═══════════════════════════════════════════════════════════════════
strategy("XAUUSD 15M Donchian Breakout [HTF]",
         shorttitle="S3·Donchian",
         overlay=true, pyramiding=0,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=1,
         initial_capital=10000,
         currency=currency.USD,
         process_orders_on_close=false,
         calc_on_every_tick=false)

// ──────────────────────────────────────────────
// EINGABE-PARAMETER
// ──────────────────────────────────────────────
grpDC = "Donchian Channel"
dcLen      = input.int(15,    "Perioden",                    group=grpDC,
                 tooltip="15 Bars = 3.75 Stunden Konsolidierungs-Fenster auf 15M.")
atrExpMult = input.float(1.1, "ATR-Expansion (× Ø-ATR)",step=0.1, group=grpDC,
                 tooltip="Aktueller ATR(14) muss ≥ X×ATR_avg(dcLen). Bestätigt Ausbruchs-Momentum.")

grpHTF = "HTF Filter (60min)"
htfTF      = input.timeframe("60", "HTF Timeframe",          group=grpHTF)
htfEMALen  = input.int(50,    "HTF EMA Länge",               group=grpHTF,
                 tooltip="Nur Ausbrüche in Richtung des 60min EMA50 werden gehandelt.")

grpEntry = "Einstieg"
bqrMin     = input.float(0.30, "Bar Quality Ratio",step=0.05, group=grpEntry,
                 tooltip="(Close-Low)/(High-Low) ≥ Wert UND Close > Open für Long-Bars.")
rsiLen     = input.int(14,    "RSI Länge",                   group=grpEntry)
rsiLongMin = input.int(45,    "RSI Long Min",                group=grpEntry,
                 tooltip="RSI ≥ 45 bestätigt Aufwärts-Momentum beim Ausbruch.")
rsiShortMax = input.int(55,   "RSI Short Max",               group=grpEntry)

grpRisk = "Risiko-Management"
slAtrMult  = input.float(2.5, "SL × ATR",         step=0.5, group=grpRisk)
rrRatio    = input.float(3.0, "Reward:Risk",       step=0.5, group=grpRisk,
                 tooltip="Default 3.0 = 1:3 R/R. Backtest IS: PF=1.30 | OoS: PF=1.21")
useBeStop  = input.bool(true,  "Break-Even Stop",            group=grpRisk)

grpSess = "Session"
sessStart  = input.int(7,  "Session Start (Stunde, UTC)",    group=grpSess)
sessEnd    = input.int(20, "Session Ende  (Stunde, UTC)",    group=grpSess)

// ──────────────────────────────────────────────
// INDIKATOREN
// ──────────────────────────────────────────────
atr    = ta.atr(14)
atrAvg = ta.sma(atr, dcLen)
rsi    = ta.rsi(close, rsiLen)

// Donchian Channel: shift(1) = kein Repainting
// DC basiert auf ABGESCHLOSSENEN Bars (high[1], low[1])
dcHigh = ta.highest(high[1], dcLen)
dcLow  = ta.lowest(low[1],   dcLen)

// HTF-Filter: 60-Minuten EMA50
htfC = request.security(syminfo.tickerid, htfTF, close,
         gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfE = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEMALen),
         gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfBull = htfC > htfE
htfBear = htfC < htfE

// ──────────────────────────────────────────────
// SIGNALBEDINGUNGEN
// ──────────────────────────────────────────────
// 1. ATR-Expansion: Ausbruch hat Momentum
atrExpand = atr >= atrAvg * atrExpMult

// 2. Donchian-Ausbruch: Close bricht erstmals aus dem Kanal
//    (close[1] <= dcHigh[1] stellt sicher: erstes Ausbruchssignal, kein Follow-Through)
brkUp = close > dcHigh and close[1] <= dcHigh[1]
brkDn = close < dcLow  and close[1] >= dcLow[1]

// 3. Bar-Qualität: direktionale Ausbruchs-Kerze
barRng = high - low
bqL = barRng > 0 ? (close - low)  / barRng >= bqrMin and close > open : false
bqS = barRng > 0 ? (high - close) / barRng >= bqrMin and close < open : false

// 4. RSI-Momentum
rsiL = rsi >= rsiLongMin  and rsi <= 80
rsiS = rsi <= rsiShortMax and rsi >= 20

// 5. Session-Filter
inSess = hour >= sessStart and hour < sessEnd

// Finale Signale
// Long:  HTF bullisch | Ausbruch nach oben | ATR-Expansion | BQ | RSI | Session
longSig  = htfBull and brkUp and atrExpand and bqL and rsiL and inSess
         and strategy.position_size == 0

// Short: HTF bärisch | Ausbruch nach unten | ATR-Expansion | BQ | RSI | Session
shortSig = htfBear and brkDn and atrExpand and bqS and rsiS and inSess
         and strategy.position_size == 0

// ──────────────────────────────────────────────
// ORDER-MANAGEMENT
// ──────────────────────────────────────────────
var float ep     = na
var float esd    = na
var bool  beDone = false

if longSig
    ep     := close
    esd    := atr * slAtrMult
    beDone := false
    strategy.entry("L", strategy.long)
    strategy.exit("L-X", "L", stop=ep - esd, limit=ep + rrRatio * esd)

if shortSig
    ep     := close
    esd    := atr * slAtrMult
    beDone := false
    strategy.entry("S", strategy.short)
    strategy.exit("S-X", "S", stop=ep + esd, limit=ep - rrRatio * esd)

if useBeStop and not beDone and not na(ep) and not na(esd)
    if strategy.position_size > 0 and high >= ep + esd
        strategy.exit("L-X", "L", stop=ep, limit=ep + rrRatio * esd)
        beDone := true
    if strategy.position_size < 0 and low <= ep - esd
        strategy.exit("S-X", "S", stop=ep, limit=ep - rrRatio * esd)
        beDone := true

if strategy.position_size == 0
    ep     := na
    esd    := na
    beDone := false

// ──────────────────────────────────────────────
// DARSTELLUNG
// ──────────────────────────────────────────────
// Donchian Channel
p_dch = plot(dcHigh, "DC High", color=color.new(color.blue,   40), style=plot.style_stepline, linewidth=1)
p_dcl = plot(dcLow,  "DC Low",  color=color.new(color.orange, 40), style=plot.style_stepline, linewidth=1)
fill(p_dch, p_dcl, color=color.new(color.gray, 92), title="DC Kanal")

// ATR-Expansion Marker
plotchar(atrExpand and inSess, "ATR Expand", "•",
         location=location.top, color=color.new(color.blue, 50), size=size.tiny)

// Signal-Pfeile
plotshape(longSig,  "Long",  style=shape.triangleup,
          location=location.belowbar, color=color.lime, size=size.small)
plotshape(shortSig, "Short", style=shape.triangledown,
          location=location.abovebar, color=color.red,  size=size.small)

// HTF-Hintergrundfarbe
bgcolor(htfBull ? color.new(color.green, 97) :
        htfBear ? color.new(color.red,   97) : na,
        title="HTF-Trend Hintergrund")
