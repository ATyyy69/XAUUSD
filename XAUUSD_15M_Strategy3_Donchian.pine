//@version=6
// ═══════════════════════════════════════════════════════════════════
// XAUUSD 15M — Strategie 3: Donchian Channel Breakout + HTF Filter
// ═══════════════════════════════════════════════════════════════════
//
// KONZEPT:
//   Donchian Channel (15 Bars) identifiziert Ausbrüche.
//   ATR-Expansion bestätigt Momentum (kein False Breakout).
//   HTF 60min EMA50 = Richtungsbias (nur Ausbrüche mit Macro-Trend).
//   Exit: 2.5×ATR SL + 1:3 TP + Break-Even Stop bei +1R.
//
// VALIDIERUNG (backtest_3strategies.py v3, echte Goldpreise 2015-2026):
//   In-Sample  (2015-2022): PF=1.30  WR=20.4%  DD=16.1%  Ret=+68.0%
//   Out-of-Sample (2023-2026): PF=1.21  WR=19.9%  DD=17.5%  Ret=+19.0%
//   NIEDRIGSTES DRAWDOWN aller 3 Strategien: 16-17%.
//   Alle 6 Marktphasen profitabel (PF 1.32–1.90)
//
// OPTIMIERTE PARAMETER: dc=15 | atr_x=1.1 | bqr=0.30 | rsi=45 | sl=2.5 | rr=3.0
// ═══════════════════════════════════════════════════════════════════
strategy("XAUUSD 15M Donchian Breakout [HTF]",
         shorttitle="S3·Donchian",
         overlay=true, pyramiding=0,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=1,
         initial_capital=10000,
         currency=currency.USD,
         process_orders_on_close=false,
         max_lines_count=500)

// ──────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────
grpDC       = "Donchian Channel"
dcLen       = input.int(15,    "Perioden",                  group=grpDC,
                  tooltip="15 Bars = 3.75h Konsolidierungsfenster auf 15M.")
atrExpMult  = input.float(1.1, "ATR-Expansion × Ø-ATR",step=0.1, group=grpDC,
                  tooltip="ATR(14) ≥ X × ATR_Ø = Ausbruchs-Momentum bestätigt.")

grpHTF      = "HTF Filter (60min)"
htfTF       = input.timeframe("60","HTF Timeframe",         group=grpHTF)
htfEMALen   = input.int(50,    "HTF EMA Länge",             group=grpHTF)

grpEntry    = "Einstieg"
bqrMin      = input.float(0.30,"Bar Quality Ratio",    step=0.05, group=grpEntry,
                  tooltip="(Close-Low)/(High-Low) ≥ Wert UND Close>Open für Long.")
rsiLen      = input.int(14,    "RSI Länge",                 group=grpEntry)
rsiLongMin  = input.int(45,    "RSI Long Min",              group=grpEntry)
rsiShortMax = input.int(55,    "RSI Short Max",             group=grpEntry)

grpRisk     = "Risiko Management"
slAtrMult   = input.float(2.5, "SL × ATR",             step=0.5, group=grpRisk)
rrRatio     = input.float(3.0, "Reward:Risk",           step=0.5, group=grpRisk,
                  tooltip="Default 3.0 = 1:3 R/R. IS: PF=1.30 | OoS: PF=1.21")
riskPct     = input.float(1.0, "Risiko pro Trade (%)", step=0.1, group=grpRisk)
useBE       = input.bool(true,  "Break-Even Stop",          group=grpRisk)
beR         = input.float(1.0, "BE Aktivierung (×R)",  step=0.1, group=grpRisk)

grpSess     = "Session"
sessStr     = input.session("0700-2000","Handelszeit",      group=grpSess)
sessTz      = input.string("Europe/Berlin","Zeitzone",      group=grpSess)

// ──────────────────────────────────────────────
// INDIKATOREN
// ──────────────────────────────────────────────
atr    = ta.atr(14)
atrAvg = ta.sma(atr, dcLen)
rsi    = ta.rsi(close, rsiLen)

// Donchian mit shift(1) → kein Repainting (basiert auf abgeschlossenen Bars)
dcHigh = ta.highest(high[1], dcLen)
dcLow  = ta.lowest(low[1],   dcLen)

htfC = request.security(syminfo.tickerid, htfTF, close,
         barmerge.gaps_off, barmerge.lookahead_off)
htfE = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEMALen),
         barmerge.gaps_off, barmerge.lookahead_off)
htfBull = htfC > htfE
htfBear = htfC < htfE

// ──────────────────────────────────────────────
// SIGNALBEDINGUNGEN
// ──────────────────────────────────────────────
atrExpand = atr >= atrAvg * atrExpMult

// Ausbruch: Close bricht aus Kanal, vorheriger Close war noch drin
brkUp = close > dcHigh and close[1] <= dcHigh[1]
brkDn = close < dcLow  and close[1] >= dcLow[1]

barRng = high - low
bqL = barRng > 0 ? (close - low)  / barRng >= bqrMin and close > open : false
bqS = barRng > 0 ? (high - close) / barRng >= bqrMin and close < open : false

rsiL = rsi >= rsiLongMin  and rsi <= 80
rsiS = rsi <= rsiShortMax and rsi >= 20

inSess = not na(time(timeframe.period, sessStr, sessTz))

longSignal  = htfBull and brkUp and atrExpand and bqL and rsiL and inSess
shortSignal = htfBear and brkDn and atrExpand and bqS and rsiS and inSess

// ──────────────────────────────────────────────
// SL / TP / POSITIONSGRÖSSE
// ──────────────────────────────────────────────
slDistL = slAtrMult * atr
slDistS = slAtrMult * atr

slPriceL = close - slDistL
tpPriceL = close + rrRatio * slDistL
slPriceS = close + slDistS
tpPriceS = close - rrRatio * slDistS

riskAmt = strategy.equity * riskPct / 100.0
qtyL = slDistL > 0 ? riskAmt / slDistL : na
qtyS = slDistS > 0 ? riskAmt / slDistS : na

// ──────────────────────────────────────────────
// TRADE STATE
// ──────────────────────────────────────────────
var float activeSL   = na
var float activeTP   = na
var float initSlDist = na
var bool  beDone     = false

// ──────────────────────────────────────────────
// ENTRY
// ──────────────────────────────────────────────
if longSignal and strategy.position_size == 0
    activeSL   := slPriceL
    activeTP   := tpPriceL
    initSlDist := slDistL
    beDone     := false
    strategy.entry("Long",  strategy.long,  qty=qtyL,  comment="DC BRK ▲")
    strategy.exit ("Long Exit", from_entry="Long", stop=activeSL, limit=activeTP)
    // Kleine Linien über (TP) und unter (SL) der Signalkerze
    line.new(bar_index, tpPriceL, bar_index + 6, tpPriceL, color=color.new(color.lime, 0), width=2)
    line.new(bar_index, slPriceL, bar_index + 6, slPriceL, color=color.new(color.red,  0), width=2)

if shortSignal and strategy.position_size == 0
    activeSL   := slPriceS
    activeTP   := tpPriceS
    initSlDist := slDistS
    beDone     := false
    strategy.entry("Short", strategy.short, qty=qtyS,  comment="DC BRK ▼")
    strategy.exit ("Short Exit", from_entry="Short", stop=activeSL, limit=activeTP)
    line.new(bar_index, tpPriceS, bar_index + 6, tpPriceS, color=color.new(color.lime, 0), width=2)
    line.new(bar_index, slPriceS, bar_index + 6, slPriceS, color=color.new(color.red,  0), width=2)

// ──────────────────────────────────────────────
// BREAK-EVEN (jeden Bar aktualisiert)
// ──────────────────────────────────────────────
if strategy.position_size > 0 and not na(initSlDist)
    ep = strategy.position_avg_price
    if useBE and not beDone
        if high - ep >= beR * initSlDist
            activeSL := math.max(activeSL, ep)
            beDone   := true
    strategy.exit("Long Exit", from_entry="Long", stop=activeSL, limit=activeTP)

if strategy.position_size < 0 and not na(initSlDist)
    ep = strategy.position_avg_price
    if useBE and not beDone
        if ep - low >= beR * initSlDist
            activeSL := math.min(activeSL, ep)
            beDone   := true
    strategy.exit("Short Exit", from_entry="Short", stop=activeSL, limit=activeTP)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeSL   := na
    activeTP   := na
    initSlDist := na
    beDone     := false

// ──────────────────────────────────────────────
// DARSTELLUNG
// ──────────────────────────────────────────────
// Donchian Channel
p_dch = plot(dcHigh, "DC High", color=color.new(color.blue,   50), style=plot.style_stepline)
p_dcl = plot(dcLow,  "DC Low",  color=color.new(color.orange, 50), style=plot.style_stepline)
fill(p_dch, p_dcl, color=color.new(color.gray, 93), title="DC Kanal")

// ATR-Expansion Indikator (kleiner Punkt wenn aktiv)
plotchar(atrExpand and inSess, "ATR+", "•",
         location=location.top, color=color.new(color.blue, 60), size=size.tiny)

// Laufende SL/TP-Linien (nur bei offener Position)
plot(strategy.position_size != 0 ? activeSL : na, "Stop-Loss",
     color=color.new(color.red,  0), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeTP : na, "Take-Profit",
     color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=2)

// Signalpfeile
plotshape(longSignal  and strategy.position_size == 0, "Long",
          style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(shortSignal and strategy.position_size == 0, "Short",
          style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

// Macro-Trend Hintergrund
bgcolor(htfBull ? color.new(color.green, 97) :
        htfBear ? color.new(color.red,   97) : na)
