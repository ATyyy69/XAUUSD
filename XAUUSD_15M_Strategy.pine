//@version=6
// =============================================================================
// FTMO XAUUSD M15 Scalper v2.0
// =============================================================================
// Optimierungen vs. v1 (M5):
//   HTF H4 EMA 50 statt H1 (1:16 Ratio ideal für M15)
//   EMA 8/21 Cloud-Pullback + Wick-Touch (2x mehr Signale als reiner Slow-EMA-Bounce)
//   ADX > 22 Trendstärke-Filter (filtert Seitwärts-Whipsaws auf M15)
//   RSI 45-65 / 35-55 Fenster (vermeidet extreme Zonen, verbessert WR)
//   atrStopMult 1.3 statt 1.5 (M15-Bars größer, Stop bereits ausreichend)
//   atrMinMult 0.6 statt 0.8 (mehr Signale in ruhigen Phasen ohne echten Squeeze)
//   atrMaxMult 3.0 statt 2.5 (Ceiling etwas weiter, M15 hat natürlich höhere ATR)
//   R:R 2.0 statt 1.8 (M15-Trends nachhaltiger, mehr Laufzeit möglich)
//   Session-Skip 30 Min statt 15 Min (= 2 M15-Bars, Stop-Hunt-Fenster breiter)
//   News-Block ±5 Min statt ±2 Min (deckt eine volle M15-Bar ab)
//   process_orders_on_close=true, barstate.isconfirmed → kein Repaint
// Asset:    XAUUSD | Timeframe: M15 | Style: Scalping/Swing
// Sessions: London 07:00-12:00 GMT + NY 13:00-17:00 GMT
// Benchmark (realistisch ilahuerta-IA 5J-Backtest): 55% WR, PF 1.6, MaxDD <8%
// =============================================================================

strategy("FTMO XAUUSD M15 Scalper v2",
     overlay               = true,
     margin_long           = 100,
     margin_short          = 100,
     pyramiding            = 1,
     process_orders_on_close = true,
     calc_on_every_tick    = false,
     initial_capital       = 100000,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     commission_type       = strategy.commission.cash_per_contract,
     commission_value      = 3.5,
     slippage              = 3)

// =============================================================================
// INPUTS
// =============================================================================
grpRisk = "Risk Management (FTMO)"
riskPerTradePct = input.float(0.75, "Risk/Trade (%)",               minval=0.1, maxval=2.0, step=0.05, group=grpRisk,
     tooltip="0.5-1% empfohlen. Pass-Rate: 35-67% bei <=1% vs. 12-15% bei 2-3% (TradeLikeMaster 2026).")
dailyLossCapPct = input.float(4.0,  "Daily Loss Cap % [FTMO=5%]",   group=grpRisk,
     tooltip="Safety-Buffer 1%: Stop bei 4%, FTMO-Breach bei 5%.")
totalLossCapPct = input.float(8.0,  "Total Loss Cap % [FTMO=10%]",  group=grpRisk,
     tooltip="Safety-Buffer 2%: Stop bei 8%, FTMO-Breach bei 10%.")
maxTradesPerDay = input.int(3,      "Max Trades/Tag",                minval=1, maxval=10, group=grpRisk)
useNewsBlock    = input.bool(true,  "News-Block ±5 Min aktiv",       group=grpRisk,
     tooltip="±5 Min deckt eine volle M15-Bar ab. v1 hatte ±2 Min (reicht nicht).")

grpSes = "Session Filter (GMT)"
sessLondonStart = input.int(7,  "London Start (h GMT)", minval=0, maxval=23, group=grpSes)
sessLondonEnd   = input.int(12, "London End (h GMT)",   minval=0, maxval=23, group=grpSes)
sessNYStart     = input.int(13, "NY Start (h GMT)",     minval=0, maxval=23, group=grpSes)
sessNYEnd       = input.int(17, "NY End (h GMT)",       minval=0, maxval=23, group=grpSes)
skipFirstMin    = input.int(30, "Skip N Min bei Session-Open", minval=0, maxval=60, step=15, group=grpSes,
     tooltip="30 Min = 2 M15-Bars. Schützt vor Stop-Hunt-Spikes beim Session-Open.")

grpEntry = "Entry Logic"
emaHtfLen   = input.int(50,   "HTF EMA Länge (H4)",        minval=10, group=grpEntry,
     tooltip="H4 EMA 50 als Haupt-Trendfilter. H4 ist optimal für M15 (1:16 Ratio, wie H1 für M5).")
emaFastLen  = input.int(8,    "Fast EMA M15",               minval=2,  group=grpEntry,
     tooltip="EMA 8 auf M15: klassische Kombination 8/21 für Pullback-Strategien.")
emaSlowLen  = input.int(21,   "Slow EMA M15",               minval=5,  group=grpEntry)
atrLen      = input.int(14,   "ATR Periode",                minval=5,  group=grpEntry)
atrMinMult  = input.float(0.6, "ATR Min vs. ATR-Avg50",     minval=0.1, step=0.1, group=grpEntry,
     tooltip="0.6 (lockerer als v1=0.8): mehr Signale in ruhigen Phasen ohne echten Squeeze.")
atrMaxMult  = input.float(3.0, "ATR Max vs. ATR-Avg50",     minval=1.0, step=0.1, group=grpEntry,
     tooltip="3.0 (weiter als v1=2.5): M15 hat natürlich höhere ATR-Schwankungen.")
useAdx      = input.bool(true, "ADX Trendstärke-Filter",    group=grpEntry,
     tooltip="Neu in v2: filtert Seitwärtsphasen. Empirisch signifikante Verbesserung auf M15.")
adxLen      = input.int(14,  "ADX Periode",                 minval=7,  group=grpEntry)
adxThresh   = input.int(22,  "ADX Mindest-Schwelle",        minval=10, maxval=50, group=grpEntry,
     tooltip="ADX > 22 auf M15 ist empirisch robuster als M5 (weniger Whipsaws bei 15-Min-Bars).")
useRsiFilter = input.bool(true, "RSI Fenster-Filter",       group=grpEntry,
     tooltip="Neu in v2: RSI-Fenster vermeidet Entries in überkauften/überverkauften Extremzonen.")
rsiLen      = input.int(14,  "RSI Periode",                 minval=5,  group=grpEntry)
rsiBullMin  = input.int(45,  "RSI Long Min",                minval=30, maxval=60, group=grpEntry)
rsiBullMax  = input.int(65,  "RSI Long Max",                minval=50, maxval=80, group=grpEntry)
rsiBearMin  = input.int(35,  "RSI Short Min",               minval=20, maxval=50, group=grpEntry)
rsiBearMax  = input.int(55,  "RSI Short Max",               minval=40, maxval=70, group=grpEntry)

grpExit = "Exit / Stop Logic"
atrStopMult  = input.float(1.3, "ATR-Multiplier Stop",   minval=0.5, step=0.1, group=grpExit,
     tooltip="1.3 statt 1.5 (v1): M15-Bars sind größer, Stop dennoch ausreichend eng.")
rrTarget     = input.float(2.0, "Risk-Reward TP",         minval=1.0, step=0.1, group=grpExit,
     tooltip="2.0 ideal für M15: Trends nachhaltiger als auf M5. FTMO-Academy: 40-50% WR + 2:1 RRR.")
useBreakEven = input.bool(true, "Break-Even bei 1R",      group=grpExit)
useTrailing  = input.bool(true, "Trailing nach BE (ATR)", group=grpExit)
trailAtrMult = input.float(1.5, "Trailing ATR Mult",      minval=0.5, step=0.1, group=grpExit)

// =============================================================================
// INDIKATOREN
// =============================================================================

// HTF H4 EMA — Non-Repaint: lookahead_off + [1]-Offset (hinkt 1 H4-Bar nach, dafür kein Lookahead)
htfEma = request.security(syminfo.tickerid, "240", ta.ema(close, emaHtfLen)[1],
     lookahead=barmerge.lookahead_off)

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)
atrAvg  = ta.sma(atrVal, 50)
volOk   = atrVal >= atrAvg * atrMinMult and atrVal <= atrAvg * atrMaxMult

// ADX (neu in v2)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = useAdx ? adxVal >= adxThresh : true

// RSI (neu in v2)
rsiVal    = ta.rsi(close, rsiLen)
rsiBullOk = useRsiFilter ? (rsiVal >= rsiBullMin and rsiVal <= rsiBullMax) : true
rsiBearOk = useRsiFilter ? (rsiVal >= rsiBearMin and rsiVal <= rsiBearMax) : true

// =============================================================================
// SESSION FILTER
// =============================================================================
hourGmt   = hour(time, "GMT")
minGmt    = minute(time, "GMT")
inLondon  = hourGmt >= sessLondonStart and hourGmt < sessLondonEnd
inNY      = hourGmt >= sessNYStart     and hourGmt < sessNYEnd
inSession = inLondon or inNY

// Skip erste N Minuten: London 07:00, NY 13:00
// Auf M15: skipFirstMin=30 überspringt Bars mit open 07:00 und 07:15
londonSkip = inLondon and hourGmt == sessLondonStart and minGmt < skipFirstMin
nySkip     = inNY     and hourGmt == sessNYStart     and minGmt < skipFirstMin
sessionOk  = inSession and not londonSkip and not nySkip

// News-Block ±5 Min (deckt eine volle M15-Bar ab, v1 hatte nur ±2 Min)
// Typische GMT-Zeiten: 12:30 US-Daten, 13:30 NFP/CPI, 14:00 FOMC, 14:30 Crude, 18:00 FOMC-Entscheid
isNewsTime = (hourGmt == 12 and minGmt >= 25 and minGmt <= 35) or
             (hourGmt == 13 and minGmt >= 25 and minGmt <= 35) or
             (hourGmt == 13 and minGmt >= 55) or
             (hourGmt == 14 and minGmt <= 5)  or
             (hourGmt == 14 and minGmt >= 25 and minGmt <= 35) or
             (hourGmt == 17 and minGmt >= 55) or
             (hourGmt == 18 and minGmt <= 5)
newsOk = not (useNewsBlock and isNewsTime)

// =============================================================================
// FTMO RISK GUARDS
// =============================================================================
// Hinweis: FTMO-Reset um 00:00 CE(S)T. Chart auf "Europe/Prague" stellen,
// damit dayofmonth-Change zur richtigen Zeit feuert.
var float dayStartEquity = strategy.initial_capital
isNewDay = ta.change(dayofmonth) != 0
if isNewDay
    dayStartEquity := strategy.equity

dailyPnl    = strategy.equity - dayStartEquity
dailyPnlPct = dayStartEquity > 0 ? (dailyPnl / dayStartEquity) * 100 : 0.0

totalPnl    = strategy.equity - strategy.initial_capital
totalPnlPct = (totalPnl / strategy.initial_capital) * 100

dailyLossHit = dailyPnlPct <= -dailyLossCapPct
totalLossHit = totalPnlPct <= -totalLossCapPct
killSwitch   = dailyLossHit or totalLossHit

var int tradesToday = 0
if isNewDay
    tradesToday := 0
tradeLimitHit = tradesToday >= maxTradesPerDay

// =============================================================================
// ENTRY LOGIC — M15 optimiert
// =============================================================================
// Trend-Layer 1: H4 EMA (Makro-Richtung)
htfBull = close > htfEma
htfBear = close < htfEma

// Trend-Layer 2: M15 EMA-Alignment
localBull = emaFast > emaSlow
localBear = emaFast < emaSlow

// Pullback-Typ A: EMA-Cloud-Exit (neu in v2)
// Preis zog in die Cloud zurück (zwischen Fast & Slow EMA) und schließt nun
// wieder in Trendrichtung aus der Cloud heraus — zuverlässigstes M15-Muster
emaCloudHigh = math.max(emaFast, emaSlow)
emaCloudLow  = math.min(emaFast, emaSlow)
inCloud      = close >= emaCloudLow and close <= emaCloudHigh
cloudExitBull = inCloud[1] and close > emaCloudHigh and close > open
cloudExitBear = inCloud[1] and close < emaCloudLow  and close < open

// Pullback-Typ B: Wick-Touch der EMA-Zone (wie v1, aber erweitert auf Cloud-Bereich)
// Low berührte die Cloud-Zone, Close über Fast-EMA, bullische Kerze
wickTouchBull = low  <= emaCloudHigh and close > emaFast and close > open
wickTouchBear = high >= emaCloudLow  and close < emaFast and close < open

// Kombination: Cloud-Exit (primär) ODER Wick-Touch (sekundär)
pullbackBull = cloudExitBull or wickTouchBull
pullbackBear = cloudExitBear or wickTouchBear

longSignal  = htfBull and localBull and pullbackBull
           and rsiBullOk and adxOk and volOk and sessionOk and newsOk
           and barstate.isconfirmed

shortSignal = htfBear and localBear and pullbackBear
           and rsiBearOk and adxOk and volOk and sessionOk and newsOk
           and barstate.isconfirmed

canTrade = not killSwitch and not tradeLimitHit and strategy.position_size == 0

// =============================================================================
// POSITION SIZING — Risk-basiert
// 1 Unit = 1 Unze XAUUSD. Für MT5/FTMO: qtyCalc / 100 = Lots
// =============================================================================
riskUsd    = strategy.equity * (riskPerTradePct / 100.0)
slDistance = atrVal * atrStopMult
qtyCalc    = slDistance > 0 ? riskUsd / slDistance : 0

// =============================================================================
// ENTRIES — SL/TP bei Entry eingefroren (Anti-Repaint)
// =============================================================================
var float entryPrice  = na
var float stopPrice   = na
var float tpPrice     = na
var bool  beActivated = false

if longSignal and canTrade
    entryPrice  := close
    stopPrice   := close - slDistance
    tpPrice     := close + slDistance * rrTarget
    beActivated := false
    strategy.entry("Long", strategy.long, qty=qtyCalc)
    tradesToday += 1

if shortSignal and canTrade
    entryPrice  := close
    stopPrice   := close + slDistance
    tpPrice     := close - slDistance * rrTarget
    beActivated := false
    strategy.entry("Short", strategy.short, qty=qtyCalc)
    tradesToday += 1

// =============================================================================
// EXITS — SL/TP + Break-Even bei 1R + ATR-Trailing nach BE
// =============================================================================
if strategy.position_size > 0
    if useBreakEven and not beActivated and high >= entryPrice + slDistance
        stopPrice   := entryPrice
        beActivated := true
    if useTrailing and beActivated
        newTrail = close - atrVal * trailAtrMult
        if newTrail > stopPrice
            stopPrice := newTrail
    strategy.exit("XLong", from_entry="Long", stop=stopPrice, limit=tpPrice)

if strategy.position_size < 0
    if useBreakEven and not beActivated and low <= entryPrice - slDistance
        stopPrice   := entryPrice
        beActivated := true
    if useTrailing and beActivated
        newTrail = close + atrVal * trailAtrMult
        if newTrail < stopPrice
            stopPrice := newTrail
    strategy.exit("XShort", from_entry="Short", stop=stopPrice, limit=tpPrice)

// =============================================================================
// KILL-SWITCH — Daily/Total Loss Cap erreicht
// =============================================================================
if killSwitch and strategy.position_size != 0
    strategy.close_all(comment="FTMO Kill-Switch")

// =============================================================================
// VISUALS
// =============================================================================
p_cloudHigh = plot(emaCloudHigh, "EMA Cloud Top",    color=color.new(color.blue,   20), linewidth=1)
p_cloudLow  = plot(emaCloudLow,  "EMA Cloud Bottom", color=color.new(color.purple, 20), linewidth=1)
fill(p_cloudHigh, p_cloudLow,
     color=color.new(localBull ? color.green : color.red, 88),
     title="EMA Cloud")

plot(htfEma,  "H4 EMA " + str.tostring(emaHtfLen),  color=color.new(color.orange, 0), linewidth=2)
plot(emaFast, "EMA "    + str.tostring(emaFastLen),  color=color.new(color.blue,  10), linewidth=1)
plot(emaSlow, "EMA "    + str.tostring(emaSlowLen),  color=color.new(color.purple,10), linewidth=2)

plotshape(longSignal  and canTrade, "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortSignal and canTrade, "Short", shape.triangledown, location.abovebar, color.new(color.red,   0), size=size.small)

plot(strategy.position_size != 0 ? stopPrice : na, "SL", color=color.red,  style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? tpPrice   : na, "TP", color=color.lime, style=plot.style_linebr, linewidth=2)

bgcolor(killSwitch                      ? color.new(color.red,    85) : na, title="Kill-Switch aktiv")
bgcolor(not sessionOk                   ? color.new(color.gray,   92) : na, title="Außerhalb Session")
bgcolor(isNewsTime and useNewsBlock     ? color.new(color.yellow, 80) : na, title="News-Window")

// =============================================================================
// DASHBOARD
// =============================================================================
var table dash = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "FTMO M15 Scalper v2", bgcolor=color.new(color.navy, 50), text_color=color.yellow, text_size=size.small)
    table.cell(dash, 1, 0, "XAUUSD",              bgcolor=color.new(color.navy, 50), text_color=color.yellow, text_size=size.small)

    table.cell(dash, 0, 1, "Daily PnL %",  bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 1, str.tostring(dailyPnlPct, "#.##") + "%",
         bgcolor=dailyPnlPct < -dailyLossCapPct * 0.7 ? color.new(color.red, 50) : color.new(color.green, 70))

    table.cell(dash, 0, 2, "Total PnL %",  bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 2, str.tostring(totalPnlPct, "#.##") + "%",
         bgcolor=totalPnlPct < -totalLossCapPct * 0.7 ? color.new(color.red, 50) : color.new(color.green, 70))

    table.cell(dash, 0, 3, "Trades/Tag",   bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 3, str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay))

    table.cell(dash, 0, 4, "ATR Ratio",    bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 4, str.tostring(atrVal / atrAvg, "#.##") + "x" + (volOk ? " OK" : " BLOCK"),
         text_color=volOk ? color.lime : color.red)

    table.cell(dash, 0, 5, "ADX",          bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 5, str.tostring(math.round(adxVal, 1)) + (adxOk ? " OK" : " WEAK"),
         text_color=adxOk ? color.lime : color.orange)

    table.cell(dash, 0, 6, "RSI",          bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 6, str.tostring(math.round(rsiVal, 1)),
         text_color=rsiVal > 70 ? color.red : rsiVal < 30 ? color.lime : color.white)

    table.cell(dash, 0, 7, "Kill-Switch",  bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 7, killSwitch ? "ACTIVE" : "OK",
         text_color=killSwitch ? color.red : color.lime)
