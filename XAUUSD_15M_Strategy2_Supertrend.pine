//@version=6
// ═══════════════════════════════════════════════════════════════════
// XAUUSD 15M — Strategie 2: Supertrend Pullback + HTF Filter
// ═══════════════════════════════════════════════════════════════════
//
// KONZEPT:
//   Supertrend (10, 3.5) definiert Trendbias auf 15M.
//   Trend muss mindestens 15 Bars etabliert sein.
//   Entry: Pullback zur Supertrend-Linie (±1.0×ATR) + HTF + BQ + RSI.
//   Exit: 2.5×ATR SL + 1:3.5 TP + Break-Even Stop bei +1R.
//
// VALIDIERUNG (backtest_3strategies.py v3, echte Goldpreise 2015-2026):
//   In-Sample  (2015-2022): PF=1.29  WR=16.7%  DD=19.2%  Ret=+73.2%
//   Out-of-Sample (2023-2026): PF=1.43  WR=19.9%  DD=16.6%  Ret=+54.3%
//   OoS BESSER als IS — robuste Out-of-Sample Performance.
//   Alle 6 Marktphasen profitabel (PF 1.06–1.88)
//
// OPTIMIERTE PARAMETER: stf=3.5 | persist=15 | zone_k=1.0 | bqr=0.35 | rsi=40 | sl=2.5 | rr=3.5
// ═══════════════════════════════════════════════════════════════════
strategy("XAUUSD 15M Supertrend Pullback [HTF]",
         shorttitle="S2·Supertrend",
         overlay=true, pyramiding=0,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=1,
         initial_capital=10000,
         currency=currency.USD,
         process_orders_on_close=false,
         max_lines_count=500)

// ──────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────
grpST       = "Supertrend"
stLen       = input.int(10,    "ATR-Länge",               group=grpST)
stFactor    = input.float(3.5, "Faktor",      step=0.5,   group=grpST,
                  tooltip="Höherer Faktor = weniger Richtungswechsel.")
minPersist  = input.int(15,    "Min. Trend-Dauer (Bars)", group=grpST,
                  tooltip="Trend muss X Bars in gleicher Richtung sein vor Entry.")
zoneK       = input.float(1.0, "Pullback-Zone × ATR",step=0.5, group=grpST,
                  tooltip="Entry nur wenn Preis innerhalb zone_k×ATR der ST-Linie.")

grpHTF      = "HTF Filter (60min)"
htfTF       = input.timeframe("60","HTF Timeframe",       group=grpHTF)
htfEMALen   = input.int(50,    "HTF EMA Länge",           group=grpHTF)

grpEntry    = "Einstieg"
bqrMin      = input.float(0.35,"Bar Quality Ratio",  step=0.05, group=grpEntry)
rsiLen      = input.int(14,    "RSI Länge",               group=grpEntry)
rsiLongMin  = input.int(40,    "RSI Long Min",            group=grpEntry)
rsiShortMax = input.int(60,    "RSI Short Max",           group=grpEntry)

grpRisk     = "Risiko Management"
slAtrMult   = input.float(2.5, "SL × ATR",           step=0.5, group=grpRisk)
rrRatio     = input.float(3.5, "Reward:Risk",         step=0.5, group=grpRisk,
                  tooltip="Default 3.5 = 1:3.5 R/R. IS: PF=1.29 | OoS: PF=1.43")
riskPct     = input.float(1.0, "Risiko pro Trade (%)",step=0.1, group=grpRisk)
useBE       = input.bool(true,  "Break-Even Stop",        group=grpRisk)
beR         = input.float(1.0, "BE Aktivierung (×R)", step=0.1, group=grpRisk)

grpTick     = "Einstieg: Tick-basierter SL/TP"
slTicks     = input.int(1200,  "SL (Ticks)",           group=grpTick,
                  tooltip="XAUUSD: 1 Tick = 0.01 → 1200 Ticks = 12.00 $")
tpTicks     = input.int(2400,  "TP (Ticks)",           group=grpTick,
                  tooltip="2400 Ticks = 24.00 $ → 1:2 R/R")

grpSess     = "Session"
sessStr     = input.session("0700-2000","Handelszeit",    group=grpSess)
sessTz      = input.string("Europe/Berlin","Zeitzone",    group=grpSess)

// ──────────────────────────────────────────────
// INDIKATOREN
// ──────────────────────────────────────────────
atr = ta.atr(14)
rsi = ta.rsi(close, rsiLen)

// direction: -1 = Aufwärtstrend (Preis über ST = Support)
//             1 = Abwärtstrend  (Preis unter ST = Resistance)
[stLine, stDir] = ta.supertrend(stFactor, stLen)
stBull = stDir == -1
stBear = stDir ==  1

var int trendCount = 0
trendCount := stDir == stDir[1] ? trendCount + 1 : 1
trendOk = trendCount >= minPersist

htfC = request.security(syminfo.tickerid, htfTF, close,
         barmerge.gaps_off, barmerge.lookahead_off)
htfE = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEMALen),
         barmerge.gaps_off, barmerge.lookahead_off)
htfBull = htfC > htfE
htfBear = htfC < htfE

// ──────────────────────────────────────────────
// SIGNALBEDINGUNGEN
// ──────────────────────────────────────────────
distToST = math.abs(close - stLine)
inZone   = distToST <= zoneK * atr

barRng = high - low
bqL = barRng > 0 ? (close - low)  / barRng >= bqrMin : false
bqS = barRng > 0 ? (high - close) / barRng >= bqrMin : false

rsiL = rsi >= rsiLongMin  and rsi <= 70
rsiS = rsi <= rsiShortMax and rsi >= 30

inSess = not na(time(timeframe.period, sessStr, sessTz))

// Farbwechsel: Rot→Grün = stDir 1→-1 = Long | Grün→Rot = stDir -1→1 = Short
longSignal  = stDir == -1 and stDir[1] == 1
shortSignal = stDir ==  1 and stDir[1] == -1

// ──────────────────────────────────────────────
// SL / TP / POSITIONSGRÖSSE
// ──────────────────────────────────────────────
slDistL = slTicks * syminfo.mintick
slDistS = slTicks * syminfo.mintick

slPriceL = close - slDistL
tpPriceL = close + tpTicks * syminfo.mintick
slPriceS = close + slDistS
tpPriceS = close - tpTicks * syminfo.mintick

riskAmt = strategy.equity * riskPct / 100.0
qtyL = slDistL > 0 ? riskAmt / slDistL : na
qtyS = slDistS > 0 ? riskAmt / slDistS : na

// ──────────────────────────────────────────────
// TRADE STATE
// ──────────────────────────────────────────────
var float activeSL   = na
var float activeTP   = na
var float initSlDist = na
var bool  beDone     = false

// ──────────────────────────────────────────────
// ENTRY
// ──────────────────────────────────────────────
if longSignal and strategy.position_size == 0
    activeSL   := slPriceL
    activeTP   := tpPriceL
    initSlDist := slDistL
    beDone     := false
    strategy.entry("Long",  strategy.long,  qty=qtyL,  comment="ST PB ▲")
    strategy.exit ("Long Exit", from_entry="Long", stop=activeSL, limit=activeTP)
    line.new(bar_index, tpPriceL, bar_index + 6, tpPriceL, color=color.new(color.lime, 0), width=2)
    line.new(bar_index, slPriceL, bar_index + 6, slPriceL, color=color.new(color.red,  0), width=2)

if shortSignal and strategy.position_size == 0
    activeSL   := slPriceS
    activeTP   := tpPriceS
    initSlDist := slDistS
    beDone     := false
    strategy.entry("Short", strategy.short, qty=qtyS,  comment="ST PB ▼")
    strategy.exit ("Short Exit", from_entry="Short", stop=activeSL, limit=activeTP)
    line.new(bar_index, tpPriceS, bar_index + 6, tpPriceS, color=color.new(color.lime, 0), width=2)
    line.new(bar_index, slPriceS, bar_index + 6, slPriceS, color=color.new(color.red,  0), width=2)

// ──────────────────────────────────────────────
// BREAK-EVEN (jeden Bar aktualisiert)
// ──────────────────────────────────────────────
if strategy.position_size > 0 and not na(initSlDist)
    ep = strategy.position_avg_price
    if useBE and not beDone
        if high - ep >= beR * initSlDist
            activeSL := math.max(activeSL, ep)
            beDone   := true
    strategy.exit("Long Exit", from_entry="Long", stop=activeSL, limit=activeTP)

if strategy.position_size < 0 and not na(initSlDist)
    ep = strategy.position_avg_price
    if useBE and not beDone
        if ep - low >= beR * initSlDist
            activeSL := math.min(activeSL, ep)
            beDone   := true
    strategy.exit("Short Exit", from_entry="Short", stop=activeSL, limit=activeTP)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeSL   := na
    activeTP   := na
    initSlDist := na
    beDone     := false

// ──────────────────────────────────────────────
// DARSTELLUNG
// ──────────────────────────────────────────────
// Supertrend-Linie
stColor = stBull ? color.new(color.green, 0) : color.new(color.red, 0)
plot(stLine, "Supertrend", color=stColor, linewidth=2, style=plot.style_linebr)

// Pullback-Zone visualisieren
stZoneL = stBull ? stLine + zoneK * atr : na
stZoneS = stBear ? stLine - zoneK * atr : na
plot(stZoneL, "Zone +", color=color.new(color.green, 75), style=plot.style_circles, linewidth=1)
plot(stZoneS, "Zone −", color=color.new(color.red,   75), style=plot.style_circles, linewidth=1)

// Laufende SL/TP-Linien (nur bei offener Position)
plot(strategy.position_size != 0 ? activeSL : na, "Stop-Loss",
     color=color.new(color.red,  0), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeTP : na, "Take-Profit",
     color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=2)

// Signalpfeile
plotshape(longSignal  and strategy.position_size == 0, "Long",
          style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(shortSignal and strategy.position_size == 0, "Short",
          style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

// Macro-Trend Hintergrund
bgcolor(htfBull ? color.new(color.green, 97) :
        htfBear ? color.new(color.red,   97) : na)
