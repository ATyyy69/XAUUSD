//@version=6
// Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International
// Original Indicator: Machine Learning RSI | AI Classification & Ranking © Zeiierman
// Strategy S3 v2: ML RSI Trend Pullback — HTF + Session gefiltert
// ═══════════════════════════════════════════════════════════════════
// KONZEPT:
//   Eintritt in etablierte ML-Trends (stanceAge ≥ 5 Bars) nach
//   einem tiefen RSI-Rücksetzer in die neutrale Zone.
//   Long:  mlRSI fällt unter 42 → kreuzt zurück über 46 (Bounce).
//   Short: mlRSI steigt über 58 → kreuzt zurück unter 54 (Rejection).
//   Filter: 60M HTF EMA50 + Session 07–20 UTC + kein Chop.
//   SL: ML ST + 0.4×ATR | TP: 3×R | BE: +1R
// ═══════════════════════════════════════════════════════════════════
strategy('ML RSI S3 · Pullback',
     shorttitle              = 'ML·S3·Pull',
     overlay                 = false,
     pyramiding              = 0,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 1,
     initial_capital         = 10000,
     currency                = currency.USD,
     process_orders_on_close = true,
     max_bars_back           = 2100,
     max_labels_count        = 500,
     max_lines_count         = 500,
     precision               = 2)

// ─── TOOLTIPS ────────────────────────────────────────────────────────────────
var string t1  = "PRICE SOURCE"
var string t2  = "BASE RSI LENGTH\n\nLower (7–10) = more signals. Higher (20–30) = fewer, cleaner."
var string t3  = "MEMORY DEPTH\n\n300–500 suits most instruments."
var string t4  = "ANALOG COUNT (k)\n\n5–8 = reactive. 12–20 = smoother consensus."
var string t5  = "SHOW ENTRY MARKERS\n\nToggles ▲/▼ arrows on the price chart."
var string t6  = "CANDLE COLORING\n\nSubtle regime tint on price candles (off by default)."
var string t7  = "MIN RANK (0–100)"
var string t8  = "MIN CONFIDENCE (0–100)"
var string t9  = "TREND GATE"
var string t10 = "VOLATILITY BAND"
var string t11 = "MIN VOL RANK"
var string t12 = "CHOP FILTER"
var string t13 = "LEARNING SENSITIVITY (×ATR)"
var string t14 = "AUTO-OPTIMIZE WEIGHTS"
var string t15 = "ADAPTATION SPEED"
var string t16 = "WEIGHT · RSI VALUE"
var string t17 = "WEIGHT · RSI SLOPE"
var string t18 = "WEIGHT · RSI ACCELERATION"
var string t19 = "WEIGHT · RSI MIDPOINT DISTANCE"
var string t20 = "WEIGHT · RSI PERCENTILE"
var string t21 = "WEIGHT · RSI VOLATILITY"
var string t22 = "WEIGHT · RSI FAST/SLOW SPREAD"
var string t23 = "WEIGHT · RSI REGIME"
var string t24 = "SHOW ML SUPERTREND LINE"
var string t25 = "SUPERTREND SOURCE"
var string t26 = "ATR MULTIPLIER\n\nDefault 2.5 — saubere Trends ohne zu viele Flips auf XAUUSD 15M."
var string t27 = "ML BAND ADAPTIVITY"
var string t28 = "SIGNAL LINE TYPE"
var string t29 = "SIGNAL LINE LENGTH"
var string t31 = "ENTRY ARROW COLORS"
var string t32 = "SUPERTREND LINE COLORS"
var string t33 = "RSI LINE COLORS"
var string t34 = "SIGNAL LINE COLOR"

// ─── TYPES ───────────────────────────────────────────────────────────────────
type Features
    float value
    float slope
    float accel
    float mid
    float pct
    float churn
    float spread
    float regime

type Weights
    float value
    float slope
    float accel
    float mid
    float pct
    float churn
    float spread
    float regime

type Neighbor
    float gap
    int cls

type Vote
    float total = 0.0
    float bull  = 0.0
    float bear  = 0.0
    float score = 0.0

type Engine
    float analogScore = 0.0
    int   biasDir     = 0
    float agreeFrac   = 0.0
    float gapTight    = 0.0
    int   k           = 0

type Context
    bool  upTrend
    bool  downTrend
    float atrPct
    bool  volHealthy
    bool  chopRaw
    bool  chopNow
    float oscReg
    bool  slopeUp
    bool  slopeFit
    bool  stretched
    bool  oscSmoothUp

type Setup
    float rank = 0.0
    float conf = 0.0
    int   dir  = 0

// ─── INPUTS ──────────────────────────────────────────────────────────────────
// ML Brain
priceSrc    = input.source(close, 'Price Source',        group = 'ML Brain',                 tooltip = t1)
rsiBase     = input.int(14,       'Base RSI Length',     group = 'ML Brain', minval = 2,     tooltip = t2)
memoryDepth = input.int(500,      'Memory Depth (bars)', group = 'ML Brain', minval = 80, maxval = 5000, tooltip = t3)
kNeighbors  = input.int(8,        'Analog Count (k)',    group = 'ML Brain', minval = 1, maxval = 64, tooltip = t4)
winLen      = 100
spacingBars = 4
horizonBars = 4

// Signals
showMarks    = input.bool(true,  'Show Entry Markers', inline = 'show', group = 'Signals', tooltip = t5)
paintBars    = input.bool(false, 'Candle Coloring',    inline = 'show', group = 'Signals', tooltip = t6)
gateRank     = input.int(50,     'Min Rank',           minval = 0, maxval = 100, group = 'Signals', tooltip = t7)
gateConf     = input.int(40,     'Min Confidence',     minval = 0, maxval = 100, group = 'Signals', tooltip = t8)
useTrendGate = input.bool(true,  'Trend Gate',         group = 'Signals', tooltip = t9)
useVolBand   = input.bool(true,  'Volatility Band',    inline = 'vol', group = 'Signals', tooltip = t10)
volBandLo    = input.int(20,     'Min Vol Rank',       minval = 0, maxval = 100, inline = 'vol', group = 'Signals', tooltip = t11)
useChop      = input.bool(true,  'Chop Filter',        group = 'Signals', tooltip = t12)
atrFactor    = input.float(0.5,  'Learning Sensitivity', minval = 0, step = 0.1, group = 'Signals', tooltip = t13)
trendLen  = 50
chopCut   = 0.5
volBandHi = 85

// Auto Weight Optimizer
autoWeightsOn = input.bool(true, 'Auto-Optimize Weights', group = 'Auto Weight Optimizer', tooltip = t14)
autoSpeed     = input.float(1,   'Adaptation Speed', minval = 0.005, maxval = 1.0, step = 0.005, group = 'Auto Weight Optimizer', active = autoWeightsOn, tooltip = t15)
autoFloor   = 0.5
autoMinRows = 60

// Feature Weights
wVal = input.float(1.0, 'RSI Value',          minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t16)
wSlp = input.float(1.0, 'RSI Slope',          minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t17)
wAcc = input.float(1.0, 'RSI Acceleration',   minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t18)
wMid = input.float(1.0, 'RSI Midpoint Dist',  minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t19)
wPct = input.float(1.0, 'RSI Percentile',     minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t20)
wChn = input.float(1.0, 'RSI Volatility',     minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t21)
wSpr = input.float(1.0, 'RSI Fast/Slow Spread', minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t22)
wReg = input.float(1.0, 'RSI Regime',         minval = 0, step = 0.1, group = 'Feature Weights', active = autoWeightsOn == false, tooltip = t23)

// ML Supertrend
showSt     = input.bool(true,  'Show ML Supertrend', group = 'ML Supertrend', tooltip = t24)
stSrc      = input.source(hl2, 'Supertrend Source',  group = 'ML Supertrend', active = showSt, tooltip = t25)
stMultBase = input.float(2.5,  'ATR Multiplier',     group = 'ML Supertrend', active = showSt, minval = 0.5, step = 0.1, tooltip = t26)
stMlResp   = input.float(1.0,  'ML Band Adaptivity', group = 'ML Supertrend', active = showSt, minval = 0.0, maxval = 1.0, step = 0.05, tooltip = t27)
stAtrLen  = 10
smoothLen = 10

// RSI Signal Line
maTypeInput   = input.string('EMA', 'Type',   options = ['None','SMA','EMA','SMMA (RMA)','WMA'], group = 'RSI Signal Line', tooltip = t28)
maLengthInput = input.int(9,        'Length', group = 'RSI Signal Line', active = maTypeInput != 'None', tooltip = t29)

// Colors
sigBull       = input.color(#26c6da, 'Long',      inline = 'sig', group = 'Colors · Signals',    tooltip = t31)
sigBear       = input.color(#ff7043, 'Short',     inline = 'sig', group = 'Colors · Signals')
trailBull     = input.color(#26c6da, 'Uptrend',   inline = 'tr',  group = 'Colors · Supertrend', tooltip = t32)
trailBear     = input.color(#ff7043, 'Downtrend', inline = 'tr',  group = 'Colors · Supertrend')
rsiBull       = input.color(#26c6da, 'Bullish',   inline = 'rs',  group = 'Colors · RSI',        tooltip = t33)
rsiBear       = input.color(#ff7043, 'Bearish',   inline = 'rs',  group = 'Colors · RSI')
smoothLineCol = input.color(#e3b13a, 'Signal',    inline = 'sm',  group = 'Colors · RSI',        active = maTypeInput != 'None', tooltip = t34)

// ─── HELPERS & METHODS ───────────────────────────────────────────────────────
scale01(float _v, int _len) =>
    lo = ta.lowest(_v, _len)
    hi = ta.highest(_v, _len)
    hi == lo ? 0.5 : (_v - lo) / (hi - lo)

compress(float _d) =>
    math.log(1.0 + math.abs(_d))

ma(float source, int length, string mtype) =>
    float _sma  = ta.sma(source, length)
    float _ema  = ta.ema(source, length)
    float _rma  = ta.rma(source, length)
    float _wma  = ta.wma(source, length)
    switch mtype
        'SMA'        => _sma
        'EMA'        => _ema
        'SMMA (RMA)' => _rma
        'WMA'        => _wma
        => na

autoFeatureWeights(matrix<float> m, int minRows, float floor) =>
    int n = m.rows()
    array<float> imp = array.new<float>(8, 1.0)
    if n >= minRows
        array<float> sumB  = array.new<float>(8, 0.0)
        array<float> sumBe = array.new<float>(8, 0.0)
        array<float> sqB   = array.new<float>(8, 0.0)
        array<float> sqBe  = array.new<float>(8, 0.0)
        int cntB  = 0
        int cntBe = 0
        for i = 0 to n - 1 by 1
            float o = m.get(i, 8)
            if o > 0 or o < 0
                bool isB = o > 0
                for j = 0 to 7 by 1
                    float v = m.get(i, j)
                    if isB
                        sumB.set(j, sumB.get(j) + v)
                        sqB.set(j,  sqB.get(j)  + v * v)
                    else
                        sumBe.set(j, sumBe.get(j) + v)
                        sqBe.set(j,  sqBe.get(j)  + v * v)
                cntB  := isB ? cntB  + 1 : cntB
                cntBe := isB ? cntBe     : cntBe + 1
        if cntB > 2 and cntBe > 2
            array<float> fish = array.new<float>(8, 0.0)
            float maxF = 0.0
            for j = 0 to 7 by 1
                float mB  = sumB.get(j)  / cntB
                float mBe = sumBe.get(j) / cntBe
                float vB  = math.max(0.0, sqB.get(j)  / cntB  - mB  * mB)
                float vBe = math.max(0.0, sqBe.get(j) / cntBe - mBe * mBe)
                float f   = math.pow(mB - mBe, 2) / (vB + vBe + 1e-6)
                fish.set(j, f)
                maxF := math.max(maxF, f)
            for j = 0 to 7 by 1
                float norm = maxF > 0 ? fish.get(j) / maxF : 1.0
                imp.set(j, math.max(floor, norm * 10.0))
    imp

method sum(Weights w) =>
    w.value + w.slope + w.accel + w.mid + w.pct + w.churn + w.spread + w.regime

method gapTo(Features f, array<float> row, Weights w) =>
    w.value * compress(f.value - row.get(0)) + w.slope * compress(f.slope - row.get(1)) + w.accel *
     compress(f.accel - row.get(2)) + w.mid * compress(f.mid - row.get(3)) + w.pct *
     compress(f.pct - row.get(4)) + w.churn * compress(f.churn - row.get(5)) + w.spread *
     compress(f.spread - row.get(6)) + w.regime * compress(f.regime - row.get(7))

method consider(array<Neighbor> nbrs, int kMax, Neighbor cand) =>
    if nbrs.size() < kMax
        nbrs.push(cand)
    else
        int   worst    = 0
        float worstGap = nbrs.get(0).gap
        for i = 1 to nbrs.size() - 1 by 1
            float g = nbrs.get(i).gap
            if g > worstGap
                worstGap := g
                worst    := i
        if cand.gap < worstGap
            nbrs.set(worst, cand)

method tally(Vote v, Neighbor n) =>
    float w = 1.0 / (1.0 + n.gap)
    v.total := v.total + w
    v.score := v.score + n.cls * w
    if n.cls > 0
        v.bull := v.bull + w
    else if n.cls < 0
        v.bear := v.bear + w
    v

method aligned(Context c, int dir) =>
    dir == 1 and c.upTrend or dir == -1 and c.downTrend

// ─── RSI FEATURE ENGINE ──────────────────────────────────────────────────────
rOsc   = ta.rsi(priceSrc, rsiBase)
rOscF  = ta.rsi(priceSrc, math.max(2, math.round(rsiBase / 2)))
rOscS  = ta.rsi(priceSrc, rsiBase * 2)
atrVal = ta.atr(14)
stepLen = 3

Features cur = Features.new(
 rOsc / 100.0,
 scale01(rOsc - rOsc[stepLen], winLen),
 scale01(rOsc - rOsc[stepLen] - (rOsc[stepLen] - rOsc[2 * stepLen]), winLen),
 math.abs(rOsc - 50.0) / 50.0,
 ta.percentrank(rOsc, winLen) / 100.0,
 scale01(ta.stdev(rOsc, 14), winLen),
 scale01(rOscF - rOscS, winLen),
 scale01(ta.ema(rOsc, 20) - 50.0, winLen))

Weights wts = Weights.new(wVal, wSlp, wAcc, wMid, wPct, wChn, wSpr, wReg)

// ─── FEATURE BANK ────────────────────────────────────────────────────────────
var matrix<float> bank = matrix.new<float>(0, 9)

moveFwd = priceSrc - priceSrc[horizonBars]
bandFwd = atrFactor * atrVal[horizonBars]
outcome = moveFwd > 2 * bandFwd ? 3 : moveFwd > bandFwd ? 2 : moveFwd > 0 ? 1 :
          moveFwd < -2 * bandFwd ? -3 : moveFwd < -bandFwd ? -2 : moveFwd < 0 ? -1 : 0

Features curPast = cur[horizonBars]
fVal = na(curPast) ? na : curPast.value
fSlp = na(curPast) ? na : curPast.slope
fAcc = na(curPast) ? na : curPast.accel
fMid = na(curPast) ? na : curPast.mid
fPct = na(curPast) ? na : curPast.pct
fChn = na(curPast) ? na : curPast.churn
fSpr = na(curPast) ? na : curPast.spread
fReg = na(curPast) ? na : curPast.regime

if barstate.isconfirmed and bar_index > horizonBars
    row = array.from(fVal, fSlp, fAcc, fMid, fPct, fChn, fSpr, fReg, float(outcome))
    bank.add_row(0, row)
    if bank.rows() > memoryDepth
        bank.remove_row(bank.rows() - 1)

// ─── AUTO WEIGHT OPTIMIZER ───────────────────────────────────────────────────
var array<float> wAuto = array.new<float>(8, 1.0)
if autoWeightsOn and barstate.isconfirmed
    array<float> wRaw = autoFeatureWeights(bank, autoMinRows, autoFloor)
    for j = 0 to 7 by 1
        float prev = wAuto.get(j)
        wAuto.set(j, prev + autoSpeed * (wRaw.get(j) - prev))

if autoWeightsOn
    wts.value  := wAuto.get(0)
    wts.slope  := wAuto.get(1)
    wts.accel  := wAuto.get(2)
    wts.mid    := wAuto.get(3)
    wts.pct    := wAuto.get(4)
    wts.churn  := wAuto.get(5)
    wts.spread := wAuto.get(6)
    wts.regime := wAuto.get(7)

// ─── NEIGHBOR ENGINE ─────────────────────────────────────────────────────────
var array<Neighbor> nbrs = array.new<Neighbor>()
nbrs.clear()

bankN   = bank.rows()
scanEnd = math.min(memoryDepth - 1, bankN - 1)
if bankN > 1
    for idx = 0 to scanEnd by 1
        if idx % spacingBars == 0
            row = bank.row(idx)
            g   = cur.gapTo(row, wts)
            if not na(g)
                nbrs.consider(kNeighbors, Neighbor.new(g, int(row.get(8))))

// ─── DISTANCE-WEIGHTED VOTING ────────────────────────────────────────────────
Vote vote   = Vote.new()
float gapSum = 0.0
int   kCount = nbrs.size()
if kCount > 0
    for j = 0 to kCount - 1 by 1
        Neighbor n = nbrs.get(j)
        vote.tally(n)
        gapSum := gapSum + n.gap

Engine eng = Engine.new()
eng.k           := kCount
eng.analogScore := vote.total > 0 ? vote.score / vote.total : 0.0
eng.biasDir     := eng.analogScore > 0.15 ? 1 : eng.analogScore < -0.15 ? -1 : 0
eng.agreeFrac   := vote.total > 0 ? (eng.biasDir == 1 ? vote.bull : eng.biasDir == -1 ? vote.bear : 0.0) / vote.total : 0.0
avgGap       = kCount > 0 ? gapSum / kCount : 0.0
gapScale     = wts.sum() * 0.45 + 1e-9
eng.gapTight := math.max(0.0, math.min(1.0, 1.0 - avgGap / gapScale))

// ─── CONTEXT / REGIME ────────────────────────────────────────────────────────
var float stLong_  = na
var float stShort_ = na
var int   stDir_   = 1

emaTrend   = ta.ema(priceSrc, trendLen)
emaQuick   = ta.ema(priceSrc, 5)
atrPct     = ta.percentrank(atrVal, 100)
trendForce = atrVal > 0 ? math.abs(emaQuick - emaTrend) / atrVal : 0.0
chopRaw_   = trendForce < chopCut
slopeUp_   = rOsc > rOsc[stepLen]
oscReg_    = ta.ema(rOsc, 20)
chopNow_   = useChop ? chopRaw_ : false

// ML Adaptive Supertrend
convInst     = math.max(-1.0, math.min(1.0, eng.analogScore / 1.5))
convSmoothed = ta.ema(convInst, smoothLen)
mlDrive      = math.max(0.0, math.min(1.0,
                 math.abs(convSmoothed) * 0.5 + eng.gapTight * 0.3 + eng.agreeFrac * 0.2))
mlDrive     := chopNow_ ? mlDrive * 0.35 : mlDrive

adaptMult = stMultBase * (1.0 + stMlResp * (1.0 - mlDrive))
stAtr_    = ta.atr(stAtrLen)
upBand    = stSrc - adaptMult * stAtr_
dnBand    = stSrc + adaptMult * stAtr_

stLong_  := na(stLong_[1])  ? upBand : close[1] > stLong_[1]  ? math.max(upBand, stLong_[1])  : upBand
stShort_ := na(stShort_[1]) ? dnBand : close[1] < stShort_[1] ? math.min(dnBand, stShort_[1]) : dnBand
stDir_   := na(stDir_[1]) ? 1 :
             stDir_[1] == -1 and close > stShort_[1] ? 1  :
             stDir_[1] ==  1 and close < stLong_[1]  ? -1 :
             nz(stDir_[1], 1)

stLine_  = stDir_ == 1 ? stLong_ : stShort_
stFlipUp = stDir_ == 1  and stDir_[1] == -1
stFlipDn = stDir_ == -1 and stDir_[1] ==  1

Context ctx = Context.new(
 stDir_ == 1, stDir_ == -1, atrPct,
 atrPct >= volBandLo and atrPct <= volBandHi,
 chopRaw_, chopNow_, oscReg_, slopeUp_,
 eng.biasDir == 1 and slopeUp_ or eng.biasDir == -1 and not slopeUp_,
 eng.biasDir == 1 and rOsc > 70 or eng.biasDir == -1 and rOsc < 30,
 ta.ema(rOsc, 5) > ta.ema(rOsc, 5)[1])

// ─── SIGNAL STATE ────────────────────────────────────────────────────────────
var int stanceState = 0
var int stanceAge   = 0

gatesPass   = (not useTrendGate or ctx.aligned(eng.biasDir)) and
              (not useVolBand   or ctx.volHealthy) and
              not ctx.chopNow
stanceState := eng.biasDir == 1 and gatesPass ? 1 :
               eng.biasDir == -1 and gatesPass ? -1 : nz(stanceState[1])
stanceChanged = ta.change(stanceState) != 0
stanceAge     := stanceChanged ? 0 : stanceAge + 1
earlyFlip     = stanceChanged and (stanceChanged[1] or stanceChanged[2] or stanceChanged[3])

// ─── RANK / CONFIDENCE ───────────────────────────────────────────────────────
rankScore(Engine e, Context c, int age, bool flip) =>
    pAgree  = 25.0 * e.agreeFrac
    pGap    = 15.0 * e.gapTight
    pStruct = (c.slopeFit ? 10.0 : 0.0) + (c.stretched ? 0.0 : 5.0)
    pTrend  = c.aligned(e.biasDir) ? 10.0 : 0.0
    pVol    = c.volHealthy ? 10.0 : c.atrPct < volBandLo ? 5.0 : 3.0
    regFit  = e.biasDir == 1 and c.oscReg > 55 or e.biasDir == -1 and c.oscReg < 45
    pReg    = regFit ? 10.0 : c.oscReg >= 45 and c.oscReg <= 55 ? 4.0 : 6.0
    pSmooth = e.biasDir == 1 and c.oscSmoothUp or e.biasDir == -1 and not c.oscSmoothUp ? 5.0 : 0.0
    pHold   = math.min(5.0, age)
    pPen    = math.min(20.0, (c.chopRaw ? 8.0 : 0.0) + (c.stretched ? 6.0 : 0.0) +
              (flip ? 6.0 : 0.0) + (e.k < kNeighbors ? 5.0 * (kNeighbors - e.k) / kNeighbors : 0.0))
    raw     = pAgree + pGap + pStruct + pTrend + pVol + pReg + pSmooth + pHold - pPen
    e.biasDir == 0 ? 0.0 : math.max(0.0, math.min(100.0, raw))

confScore(Engine e, Context c, int age, bool flip) =>
    raw = 40.0 * e.agreeFrac + 25.0 * e.gapTight + 15.0 * math.min(1.0, age / 5.0) +
          10.0 * (c.slopeFit ? 1.0 : 0.0) -
          (flip ? 15.0 : 0.0) -
          (e.k < kNeighbors ? 10.0 * (kNeighbors - e.k) / kNeighbors : 0.0)
    e.biasDir == 0 ? 0.0 : math.max(0.0, math.min(100.0, raw))

Setup setup = Setup.new()
setup.dir  := eng.biasDir
setup.rank := rankScore(eng, ctx, stanceAge, earlyFlip)
setup.conf := confScore(eng, ctx, stanceAge, earlyFlip)

// ─── REGIME TONE ─────────────────────────────────────────────────────────────
intensity  = math.max(0.0, math.min(1.0, ta.ema(setup.rank, 3) / 100.0))
regimeTone = stDir_ == 1 ? trailBull : trailBear

// ─── ML RSI ──────────────────────────────────────────────────────────────────
mlTilt = math.max(-1.0, math.min(1.0, convSmoothed)) * intensity * 18.0
mlRSI  = ta.ema(math.max(0.0, math.min(100.0, rOsc + mlTilt)), 3)

// ─── RSI PANE (Clean) ────────────────────────────────────────────────────────
hline(70, 'OB',  color = color.new(color.gray, 55), linestyle = hline.style_dashed)
hline(50, 'Mid', color = color.new(color.gray, 55), linestyle = hline.style_dotted)
hline(30, 'OS',  color = color.new(color.gray, 55), linestyle = hline.style_dashed)

// Pullback zone markers
hline(46, 'PB Bull Bounce', color = color.new(#26c6da, 70), linestyle = hline.style_dotted)
hline(54, 'PB Bear Reject', color = color.new(#ff7043, 70), linestyle = hline.style_dotted)

rsiLineCol = mlRSI >= 50 ? rsiBull : rsiBear
rsiMainPlt = plot(mlRSI, 'ML RSI', color = rsiLineCol, linewidth = 2)
midRefPlt  = plot(50,    'Mid Ref', color = na, display = display.none)
fill(rsiMainPlt, midRefPlt, color = mlRSI >= 50 ? color.new(rsiBull, 82) : color.new(rsiBear, 82))

enableMA = maTypeInput != 'None'
plot(enableMA ? ma(mlRSI, maLengthInput, maTypeInput) : na, 'Signal Line',
     color = smoothLineCol, linewidth = 1)

// ─── PRICE CHART: ML SUPERTREND (Clean — no cloud) ───────────────────────────
stUpVal = showSt and stDir_ == 1  ? stLine_ : na
stDnVal = showSt and stDir_ == -1 ? stLine_ : na

plot(stUpVal, 'ST Glow ▲', color = color.new(trailBull, 62), linewidth = 5, style = plot.style_linebr, force_overlay = true)
plot(stDnVal, 'ST Glow ▼', color = color.new(trailBear, 62), linewidth = 5, style = plot.style_linebr, force_overlay = true)
plot(stUpVal, 'ML ST ▲',   color = trailBull, linewidth = 2, style = plot.style_linebr, force_overlay = true)
plot(stDnVal, 'ML ST ▼',   color = trailBear, linewidth = 2, style = plot.style_linebr, force_overlay = true)

plotshape(showSt and stFlipUp ? stLine_ : na, 'Flip ▲', shape.circle, location.absolute, trailBull, size = size.tiny,  force_overlay = true)
plotshape(showSt and stFlipDn ? stLine_ : na, 'Flip ▼', shape.circle, location.absolute, trailBear, size = size.tiny,  force_overlay = true)

barTone = stDir_ == 1 ? color.new(trailBull, 85) : color.new(trailBear, 85)
plotcandle(open, high, low, close, 'Candles',
     color = paintBars ? barTone : na, wickcolor = paintBars ? barTone : na,
     bordercolor = na, force_overlay = true)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(ta.crossover(mlRSI,  46), 'S3 Long Signal',  'ML RSI S3: Pullback Bounce Long setup.')
alertcondition(ta.crossunder(mlRSI, 54), 'S3 Short Signal', 'ML RSI S3: Pullback Rejection Short setup.')

// ═══════════════════════════════════════════════════════════════════
// STRATEGIE S3 — ML RSI TREND PULLBACK v2
// ═══════════════════════════════════════════════════════════════════
// Profi-Ansatz: Kein Entry am Flip-Bar — erst nach etabliertem Trend.
// In Bull-Trend: mlRSI fällt unter 42 (Pullback) → kreuzt über 46 (Bounce).
// In Bear-Trend: mlRSI steigt über 58 (Rejection) → kreuzt unter 54.
// Filter: 60M HTF EMA50 + Session + Rank-Gate.
// SL: ML ST-Linie + 0.4×ATR | TP: 3×R | BE: +1R
// ═══════════════════════════════════════════════════════════════════
grpS3 = 'Strategy S3 · Trend Pullback'

useHTF3  = input.bool(true,  '60M EMA50 HTF-Filter', group = grpS3,
             tooltip = 'Long nur wenn Close > 60M-EMA50. Short nur wenn Close < 60M-EMA50.')
sessH1_  = input.int(7,      'Session Start (UTC-h)', minval = 0, maxval = 23, inline = 'sess3', group = grpS3)
sessH2_  = input.int(20,     'Session End (UTC-h)',   minval = 0, maxval = 23, inline = 'sess3', group = grpS3,
             tooltip = '07–20 UTC = London Open bis New York Close.')
minAge3  = input.int(5,      'Min Stance-Alter',      minval = 2, group = grpS3,
             tooltip = 'Trend muss mind. X Bars etabliert sein — verhindert Pullback-Entry direkt nach dem Flip.')
pbDipL   = input.int(42,     'Pullback Tief (Long)',  minval = 25, maxval = 49, group = grpS3,
             tooltip = 'mlRSI muss unter diesen Wert fallen (tieferer Rücksetzer = besserer Einstiegspreis).')
pbBncL   = input.int(46,     'Bounce Trigger (Long)', minval = 30, maxval = 52, group = grpS3,
             tooltip = 'mlRSI kreuzt über diesen Wert nach dem Rücksetzer → Long-Entry.')
pbDipS   = input.int(58,     'Rejection Hoch (Short)', minval = 51, maxval = 75, group = grpS3,
             tooltip = 'mlRSI muss über diesen Wert steigen (höhere Gegenbewegung = besserer Short-Preis).')
pbBncS   = input.int(54,     'Drop Trigger (Short)', minval = 48, maxval = 70, group = grpS3,
             tooltip = 'mlRSI kreuzt unter diesen Wert nach der Gegenbewegung → Short-Entry.')
slBufS3  = input.float(0.4,  'ST-Puffer × ATR',       step = 0.1, group = grpS3)
rrS3     = input.float(3.0,  'Reward:Risk',            step = 0.5, group = grpS3,
             tooltip = '1:3 — Pullback-Entries haben bessere Preise und erlauben höheres R:R.')
rPctS3   = input.float(1.0,  'Risiko / Trade (%)',    step = 0.1, group = grpS3)
useBES3  = input.bool(true,  'Break-Even Stop',        group = grpS3)
beRS3    = input.float(1.0,  'BE bei (×R)',            step = 0.1, group = grpS3)
rnkGate3 = input.int(45,     'Mindest-Rank',          minval = 0, maxval = 100, group = grpS3,
             tooltip = 'KNN-Rank-Filter — blockiert Entry bei schwacher ML-Überzeugung.')

// HTF 60M EMA50
htfEma3  = request.security(syminfo.tickerid, '60', ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
htfBull3 = not useHTF3 or close > htfEma3
htfBear3 = not useHTF3 or close < htfEma3

// Handelssession UTC
hUTC3   = hour(time, 'UTC')
inSess3 = hUTC3 >= sessH1_ and hUTC3 < sessH2_

// Etablierter Trend
bullTrend3 = stanceState == 1  and stanceAge >= minAge3 and stDir_ == 1  and not ctx.chopNow
bearTrend3 = stanceState == -1 and stanceAge >= minAge3 and stDir_ == -1 and not ctx.chopNow

// Pullback-State: RSI hat das Rücksetzer-Niveau erreicht
var bool pbActivL = false
var bool pbActivS = false
pbActivL := mlRSI < pbDipL ? true  : mlRSI > pbBncL + 5 ? false : pbActivL
pbActivS := mlRSI > pbDipS ? true  : mlRSI < pbBncS - 5 ? false : pbActivS

// Bounce-Trigger: RSI kommt zurück in die Trendrichtung
pbBounceL = pbActivL and ta.crossover(mlRSI,  pbBncL)
pbRejectS = pbActivS and ta.crossunder(mlRSI, pbBncS)

// Finale Einstiegssignale
goL3 = bullTrend3 and pbBounceL and htfBull3 and inSess3 and setup.rank >= rnkGate3 and strategy.position_size == 0 and barstate.isconfirmed
goS3 = bearTrend3 and pbRejectS and htfBear3 and inSess3 and setup.rank >= rnkGate3 and strategy.position_size == 0 and barstate.isconfirmed

// Entry-Pfeile
buyMark3  = ta.lowest(low,  3) - 0.3 * atrVal
sellMark3 = ta.highest(high,3) + 0.3 * atrVal
plotshape(showMarks and goL3 ? buyMark3  : na, 'S3 Long',  shape.triangleup,   location.absolute, sigBull, size = size.small, force_overlay = true)
plotshape(showMarks and goS3 ? sellMark3 : na, 'S3 Short', shape.triangledown, location.absolute, sigBear, size = size.small, force_overlay = true)

// SL / TP
slPL3 = stLine_ - slBufS3 * atrVal
slPS3 = stLine_ + slBufS3 * atrVal
dL3   = math.max(close - slPL3, 0.5 * atrVal)
dS3   = math.max(slPS3 - close, 0.5 * atrVal)
tpL3  = close + rrS3 * dL3
tpS3  = close - rrS3 * dS3

rAmt3 = strategy.equity * rPctS3 / 100.0
qL3   = dL3 > 0 ? rAmt3 / dL3 : na
qS3   = dS3 > 0 ? rAmt3 / dS3 : na

var float aSL3 = na
var float aTP3 = na
var float iSD3 = na
var bool  bED3 = false

// Long Entry
if goL3
    aSL3 := slPL3
    aTP3 := tpL3
    iSD3 := dL3
    bED3 := false
    pbActivL := false
    strategy.entry('Long', strategy.long, qty = qL3, comment = 'S3·PB▲')
    strategy.exit('LX3', from_entry = 'Long', stop = aSL3, limit = aTP3)

// Short Entry
if goS3
    aSL3 := slPS3
    aTP3 := tpS3
    iSD3 := dS3
    bED3 := false
    pbActivS := false
    strategy.entry('Short', strategy.short, qty = qS3, comment = 'S3·PB▼')
    strategy.exit('SX3', from_entry = 'Short', stop = aSL3, limit = aTP3)

// Break-Even Long
if strategy.position_size > 0 and not na(iSD3)
    ep3 = strategy.position_avg_price
    if useBES3 and not bED3 and high - ep3 >= beRS3 * iSD3
        aSL3 := math.max(aSL3, ep3)
        bED3 := true
    strategy.exit('LX3', from_entry = 'Long', stop = aSL3, limit = aTP3)

// Break-Even Short
if strategy.position_size < 0 and not na(iSD3)
    ep3 = strategy.position_avg_price
    if useBES3 and not bED3 and ep3 - low >= beRS3 * iSD3
        aSL3 := math.min(aSL3, ep3)
        bED3 := true
    strategy.exit('SX3', from_entry = 'Short', stop = aSL3, limit = aTP3)

// ST-Flip Exit (Trend bricht zusammen)
if strategy.position_size > 0 and stFlipDn
    strategy.close('Long',  comment = 'S3·ST↓')
if strategy.position_size < 0 and stFlipUp
    strategy.close('Short', comment = 'S3·ST↑')

// State-Reset
if strategy.position_size == 0 and strategy.position_size[1] != 0
    aSL3 := na
    aTP3 := na
    iSD3 := na
    bED3 := false

// Laufende SL/TP Linien
plot(strategy.position_size != 0 ? aSL3 : na, 'SL', color = color.new(color.red,  0), style = plot.style_linebr, linewidth = 2, force_overlay = true)
plot(strategy.position_size != 0 ? aTP3 : na, 'TP', color = color.new(color.lime, 0), style = plot.style_linebr, linewidth = 2, force_overlay = true)
