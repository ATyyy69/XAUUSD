// ============================================================
// XAUUSD H1 Pro v3 | Pine Script v6
// FIX: strategy.exit() außerhalb Entry-Block (jede Bar geprüft)
// NEU: Supertrend, Swing-SL, Breakeven-Stop, EMA-Bounce Entry
// ============================================================
//@version=6
strategy(
     title               = "XAUUSD H1 Pro v3",
     shorttitle          = "XAU H1 v3",
     overlay             = true,
     pyramiding          = 0,
     initial_capital     = 10000,
     default_qty_type    = strategy.percent_of_equity,
     default_qty_value   = 2,
     commission_type     = strategy.commission.cash_per_order,
     commission_value    = 0.07,
     slippage            = 3,
     max_bars_back       = 500,
     calc_on_order_fills = false,
     calc_on_every_tick  = false
     )

// ============================================================
// ░░░ EINGABEN ░░░
// ============================================================

g_ema  = "EMA Einstellungen"
e1_len = input.int(20,  "EMA 20",  minval=5,  maxval=50,  group=g_ema)
e2_len = input.int(50,  "EMA 50",  minval=20, maxval=100, group=g_ema)
e3_len = input.int(200, "EMA 200", minval=50, maxval=500, group=g_ema)

g_risk = "Risk Management"
atr_p  = input.int(14,    "ATR Periode",        minval=5,  maxval=30,   group=g_risk)
sl_m   = input.float(1.5, "SL × ATR",           minval=0.5, maxval=4.0, step=0.1, group=g_risk)
tp1_m  = input.float(2.5, "TP1 × ATR (BE-Stop)",minval=1.0, maxval=8.0, step=0.1, group=g_risk)
tp2_m  = input.float(5.0, "TP2 × ATR (voll)",   minval=2.0, maxval=12.0,step=0.1, group=g_risk)

g_filt    = "Filter"
adx_min   = input.int(20,    "ADX Minimum",        minval=10, maxval=50, group=g_filt)
rsi_l_lo  = input.int(42,    "RSI Long Min",       minval=30, maxval=60, group=g_filt)
rsi_l_hi  = input.int(75,    "RSI Long Max",       minval=55, maxval=85, group=g_filt)
rsi_s_lo  = input.int(25,    "RSI Short Min",      minval=15, maxval=45, group=g_filt)
rsi_s_hi  = input.int(58,    "RSI Short Max",      minval=40, maxval=70, group=g_filt)
use_htf   = input.bool(true,  "H4 Trend Filter",   group=g_filt)
use_st    = input.bool(true,  "Supertrend Filter",  group=g_filt)
st_fac    = input.float(3.0,  "Supertrend Faktor",  minval=1.0, maxval=6.0, step=0.5, group=g_filt)
st_len    = input.int(10,     "Supertrend Länge",   minval=5,  maxval=20,  group=g_filt)
swing_n   = input.int(4,      "Swing-Bars für SL",  minval=2,  maxval=10,  group=g_filt)

g_sess   = "Session"
use_sess = input.bool(true, "Session Filter aktiv", group=g_sess)
h_start  = input.int(7,  "Von Stunde (UTC+0)",     minval=0, maxval=23, group=g_sess)
h_end    = input.int(21, "Bis Stunde (UTC+0)",     minval=1, maxval=24, group=g_sess)

g_disp    = "Darstellung"
show_emas = input.bool(true, "EMAs anzeigen",        group=g_disp)
show_st   = input.bool(true, "Supertrend anzeigen",  group=g_disp)
show_sl   = input.bool(true, "SL/TP Linien",         group=g_disp)
show_sig  = input.bool(true, "Signal Labels",        group=g_disp)
lb_len    = input.int(7,    "Linienlänge (Bars)",    minval=3, maxval=20, group=g_disp)

// ============================================================
// ░░░ INDIKATOREN ░░░
// ============================================================

e1  = ta.ema(close, e1_len)
e2  = ta.ema(close, e2_len)
e3  = ta.ema(close, e3_len)
rsi = ta.rsi(close, 14)
atr = ta.atr(atr_p)
[_, _, adx] = ta.dmi(14, 14)
[ml, ms, _] = ta.macd(close, 12, 26, 9)

// Supertrend
[st_line, st_dir] = ta.supertrend(st_fac, st_len)
st_bull = st_dir < 0   // -1 = Preis über Supertrend = bullish
st_bear = st_dir > 0   //  1 = Preis unter Supertrend = bearish

// H4 Trend
htf_e1 = request.security(syminfo.tickerid, "240", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
htf_e2 = request.security(syminfo.tickerid, "240", ta.ema(close, 50), lookahead=barmerge.lookahead_off)
htf_c  = request.security(syminfo.tickerid, "240", close,              lookahead=barmerge.lookahead_off)

// ============================================================
// ░░░ FILTER ░░░
// ============================================================

// Session (stunden-basiert — zuverlässig im Backtester)
bh       = hour(time, "UTC+0")
in_sess  = use_sess ? (bh >= h_start and bh < h_end) : true

// H4 Trend
htf_bull = use_htf ? (htf_e1 > htf_e2 and htf_c > htf_e2) : true
htf_bear = use_htf ? (htf_e1 < htf_e2 and htf_c < htf_e2) : true

// Supertrend Filter
st_ok_l  = use_st ? st_bull : true
st_ok_s  = use_st ? st_bear : true

// Vollständige EMA-Ausrichtung
full_bull = e1 > e2 and e2 > e3
full_bear = e1 < e2 and e2 < e3

// EMA-Steigung (Trend aktiv, nicht flach)
e1_up = e1 > e1[3]
e1_dn = e1 < e1[3]
e2_up = e2 > e2[5]
e2_dn = e2 < e2[5]

// ── EMA-Bounce Einstiegssignal ──────────────────────────────
// LONG: Vorherige Bar berührte EMA20 von oben → aktuelle Bar schließt darüber
ema_bounce_l = low[1] <= e1[1] * 1.0015 and close > e1 and close > open

// SHORT: Vorherige Bar berührte EMA20 von unten → aktuelle Bar schließt darunter
ema_bounce_s = high[1] >= e1[1] * 0.9985 and close < e1 and close < open

// MACD-Kreuz als Alternativsignal
macd_xl = ta.crossover(ml, ms)  and close > e2
macd_xs = ta.crossunder(ml, ms) and close < e2

// Kombiniertes Einstiegssignal
bull_sig = ema_bounce_l or macd_xl
bear_sig = ema_bounce_s or macd_xs

// RSI
rsi_ok_l = rsi >= rsi_l_lo and rsi <= rsi_l_hi
rsi_ok_s = rsi >= rsi_s_lo and rsi <= rsi_s_hi

adx_ok   = adx >= adx_min

// ============================================================
// ░░░ ENTRY BEDINGUNGEN ░░░
// ============================================================

long_cond = in_sess
          and htf_bull
          and full_bull
          and e1_up
          and e2_up
          and bull_sig
          and rsi_ok_l
          and adx_ok
          and st_ok_l
          and strategy.position_size == 0

short_cond = in_sess
           and htf_bear
           and full_bear
           and e1_dn
           and e2_dn
           and bear_sig
           and rsi_ok_s
           and adx_ok
           and st_ok_s
           and strategy.position_size == 0

// ============================================================
// ░░░ PERSISTENTE SL/TP VARIABLEN ░░░
// ============================================================

var float l_sl     = na
var float l_tp1    = na
var float l_tp2    = na
var float l_entry  = na
var float s_sl     = na
var float s_tp1    = na
var float s_tp2    = na
var float s_entry  = na
var bool  l_be     = false   // Breakeven für Long aktiviert
var bool  s_be     = false   // Breakeven für Short aktiviert

// ============================================================
// ░░░ ENTRIES — NUR Entry + Visualisierung, KEIN strategy.exit() ░░░
// ============================================================

if long_cond
    // SL: schlechtestes aus ATR-basiert UND Swing-Low (konservativer)
    swing_lo  = ta.lowest(low, swing_n)
    l_sl     := math.min(close - atr * sl_m, swing_lo - atr * 0.25)
    l_tp1    := close + atr * tp1_m
    l_tp2    := close + atr * tp2_m
    l_entry  := close
    l_be     := false

    strategy.entry("Long", strategy.long)

    if show_sig
        label.new(bar_index, low - atr * 0.5, "▲ LONG",
             style=label.style_label_up,
             color=color.new(color.green, 5), textcolor=color.white, size=size.small)
    if show_sl
        line.new(bar_index, l_sl,  bar_index + lb_len, l_sl,
             color=color.red,   width=2)
        line.new(bar_index, l_tp1, bar_index + lb_len, l_tp1,
             color=color.lime,  width=1, style=line.style_dashed)
        line.new(bar_index, l_tp2, bar_index + lb_len, l_tp2,
             color=color.green, width=2)

if short_cond
    swing_hi  = ta.highest(high, swing_n)
    s_sl     := math.max(close + atr * sl_m, swing_hi + atr * 0.25)
    s_tp1    := close - atr * tp1_m
    s_tp2    := close - atr * tp2_m
    s_entry  := close
    s_be     := false

    strategy.entry("Short", strategy.short)

    if show_sig
        label.new(bar_index, high + atr * 0.5, "▼ SHORT",
             style=label.style_label_down,
             color=color.new(color.red, 5), textcolor=color.white, size=size.small)
    if show_sl
        line.new(bar_index, s_sl,  bar_index + lb_len, s_sl,
             color=color.red,   width=2)
        line.new(bar_index, s_tp1, bar_index + lb_len, s_tp1,
             color=color.lime,  width=1, style=line.style_dashed)
        line.new(bar_index, s_tp2, bar_index + lb_len, s_tp2,
             color=color.green, width=2)

// ============================================================
// ░░░ EXITS — AUSSERHALB des Entry-Blocks, jede Bar geprüft ░░░
// WICHTIG: Das ist der zentrale Fix für "0 Trades im Backtester"
// ============================================================

// Breakeven: Stop auf Einstiegspreis ziehen wenn TP1 erreicht
if strategy.position_size > 0 and not na(l_tp1) and high >= l_tp1 and not l_be
    l_sl := l_entry
    l_be := true

if strategy.position_size < 0 and not na(s_tp1) and low <= s_tp1 and not s_be
    s_sl := s_entry
    s_be := true

// Exit Long (wird JEDE Bar aktualisiert → dynamischer Stop möglich)
if strategy.position_size > 0 and not na(l_sl)
    strategy.exit("Long Exit", "Long", stop=l_sl, limit=l_tp2)

// Exit Short
if strategy.position_size < 0 and not na(s_sl)
    strategy.exit("Short Exit", "Short", stop=s_sl, limit=s_tp2)

// Notausstieg: EMA-Kreuz gegen die Position
if strategy.position_size > 0 and ta.crossunder(e1, e2)
    strategy.close("Long", comment="EMA↓")
if strategy.position_size < 0 and ta.crossover(e1, e2)
    strategy.close("Short", comment="EMA↑")

// ============================================================
// ░░░ DARSTELLUNG ░░░
// ============================================================

// EMAs
plot(show_emas ? e1 : na, "EMA 20",  color=color.yellow,               linewidth=1)
plot(show_emas ? e2 : na, "EMA 50",  color=color.orange,               linewidth=2)
plot(show_emas ? e3 : na, "EMA 200", color=color.new(color.white, 35), linewidth=2)

// Supertrend
plot(show_st ? st_line : na, "Supertrend",
     color=st_bull ? color.new(color.lime, 40) : color.new(color.red, 40),
     linewidth=2, style=plot.style_linebr)

// Aktive SL/TP als Dauerlinien
cur_sl  = strategy.position_size > 0 ? l_sl  : strategy.position_size < 0 ? s_sl  : na
cur_tp1 = strategy.position_size > 0 ? l_tp1 : strategy.position_size < 0 ? s_tp1 : na
cur_tp2 = strategy.position_size > 0 ? l_tp2 : strategy.position_size < 0 ? s_tp2 : na

plot(cur_sl,  "SL aktiv",  color=color.new(color.red,   10), linewidth=1, style=plot.style_linebr)
plot(cur_tp1, "TP1 aktiv", color=color.new(color.lime,  10), linewidth=1, style=plot.style_linebr)
plot(cur_tp2, "TP2 aktiv", color=color.new(color.green, 10), linewidth=1, style=plot.style_linebr)

// Hintergründe
bgcolor(in_sess ? color.new(color.blue, 97) : na, title="Session")
trend_col = full_bull and htf_bull ? color.new(color.green, 97) : full_bear and htf_bear ? color.new(color.red, 97) : na
bgcolor(trend_col, title="Trend")

// ============================================================
// ░░░ INFO TABLE ░░░
// ============================================================

var table tbl = table.new(position.top_right, 2, 9,
     bgcolor=color.new(color.black, 60), border_color=color.gray, border_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "XAU H1 Pro v3", bgcolor=color.new(color.navy,40),
         text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 1, 0, "",              bgcolor=color.new(color.navy,40),
         text_color=color.yellow, text_size=size.small)

    table.cell(tbl, 0, 1, "H4 Trend",   text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 1, htf_bull ? "BULL ▲" : htf_bear ? "BEAR ▼" : "–",
         text_color=htf_bull ? color.lime : htf_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(tbl, 0, 2, "H1 Trend",   text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 2, full_bull ? "BULL ▲" : full_bear ? "BEAR ▼" : "SEITWÄRTS",
         text_color=full_bull ? color.lime : full_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(tbl, 0, 3, "Supertrend", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 3, st_bull ? "BULL ▲" : st_bear ? "BEAR ▼" : "–",
         text_color=st_bull ? color.lime : st_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(tbl, 0, 4, "Session",    text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, in_sess ? "AKTIV ✓" : "INAKTIV",
         text_color=in_sess ? color.lime : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 5, "RSI",        text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 5, str.tostring(math.round(rsi, 1)),
         text_color=rsi > 70 ? color.red : rsi < 30 ? color.lime : color.white, text_size=size.tiny)

    table.cell(tbl, 0, 6, "ADX",        text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 6, str.tostring(math.round(adx, 1)) + (adx_ok ? " ✓" : " ✗"),
         text_color=adx_ok ? color.lime : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 7, "ATR",        text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 7, str.tostring(math.round(atr, 2)),
         text_color=color.white, text_size=size.tiny)

    table.cell(tbl, 0, 8, "RRR",        text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 8, "1 : " + str.tostring(math.round(tp2_m / sl_m, 1)),
         text_color=color.white, text_size=size.tiny)
