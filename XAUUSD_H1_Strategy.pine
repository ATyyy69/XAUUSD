// ============================================================
// XAUUSD H1 Strategie v2 | Pine Script v5
// Fixes: Session-Filter, Exit-Konflikt, SL/TP Linien
// Verbesserungen: HTF-Trend, Pullback-Einstieg, höhere Trefferquote
// ============================================================
//@version=5
strategy(
     title             = "XAUUSD H1 v2 [EMA+RSI+MACD+ATR]",
     shorttitle        = "XAUUSD H1 v2",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 2,
     commission_type   = strategy.commission.cash_per_order,
     commission_value  = 0.07,
     slippage          = 3,
     max_bars_back     = 500,
     calc_on_order_fills = false,
     calc_on_every_tick  = false
     )

// ============================================================
// ░░░ EINGABEN ░░░
// ============================================================

grp_ema = "EMA Einstellungen"
ema_fast_len  = input.int(20,  "Schnelle EMA",  minval=5,  maxval=50,  group=grp_ema)
ema_slow_len  = input.int(50,  "Langsame EMA",  minval=20, maxval=200, group=grp_ema)
ema_trend_len = input.int(200, "Trend EMA",     minval=50, maxval=500, group=grp_ema)

grp_rsi = "RSI Einstellungen"
rsi_len       = input.int(14, "RSI Periode",  minval=5, maxval=30, group=grp_rsi)
rsi_long_min  = input.int(40, "RSI Long Min", minval=30, maxval=60, group=grp_rsi)
rsi_long_max  = input.int(72, "RSI Long Max", minval=55, maxval=85, group=grp_rsi)
rsi_short_min = input.int(28, "RSI Short Min",minval=15, maxval=45, group=grp_rsi)
rsi_short_max = input.int(60, "RSI Short Max",minval=40, maxval=70, group=grp_rsi)

grp_macd = "MACD Einstellungen"
macd_fast   = input.int(12, "Fast",   minval=5,  maxval=30, group=grp_macd)
macd_slow   = input.int(26, "Slow",   minval=10, maxval=60, group=grp_macd)
macd_sig    = input.int(9,  "Signal", minval=3,  maxval=20, group=grp_macd)

grp_risk = "Risk Management"
atr_len  = input.int(14,   "ATR Periode",    minval=5,  maxval=30,  group=grp_risk)
sl_mult  = input.float(1.5, "SL  × ATR",     minval=0.5, maxval=4.0, step=0.1, group=grp_risk)
tp1_mult = input.float(2.0, "TP1 × ATR (50%)", minval=1.0, maxval=8.0, step=0.1, group=grp_risk)
tp2_mult = input.float(4.5, "TP2 × ATR (50%)", minval=2.0, maxval=12.0, step=0.1, group=grp_risk)

grp_adx = "ADX Filter"
use_adx    = input.bool(true, "ADX aktiv",       group=grp_adx)
adx_len    = input.int(14,   "ADX Periode",      minval=7,  maxval=30, group=grp_adx)
adx_thresh = input.int(20,   "ADX Min-Schwelle", minval=10, maxval=50, group=grp_adx)

grp_htf = "Higher Timeframe (H4) Bestätigung"
use_htf = input.bool(true, "H4 Trend bestätigen", group=grp_htf)

grp_sess = "Session Filter"
use_session  = input.bool(true, "Session Filter aktiv", group=grp_sess)
sess_h_start = input.int(7,  "Start Stunde (UTC)", minval=0, maxval=23, group=grp_sess)
sess_h_end   = input.int(21, "End Stunde (UTC)",   minval=1, maxval=24, group=grp_sess)

grp_disp = "Darstellung"
show_emas    = input.bool(true, "EMAs anzeigen",        group=grp_disp)
show_lines   = input.bool(true, "SL/TP Linien anzeigen",group=grp_disp)
show_labels  = input.bool(true, "Signal Labels",        group=grp_disp)
line_bars    = input.int(8,    "Linienlänge (Bars)",    minval=3, maxval=20, group=grp_disp)

// ============================================================
// ░░░ INDIKATOREN ░░░
// ============================================================

ema_fast  = ta.ema(close, ema_fast_len)
ema_slow  = ta.ema(close, ema_slow_len)
ema_trend = ta.ema(close, ema_trend_len)

rsi = ta.rsi(close, rsi_len)

[macd_line, sig_line, macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_sig)

atr = ta.atr(atr_len)

[_, _, adx_val] = ta.dmi(adx_len, adx_len)

// H4 Trend via request.security (kein Lookahead → kein Repainting)
htf_close     = request.security(syminfo.tickerid, "240", close,          lookahead=barmerge.lookahead_off)
htf_ema_fast  = request.security(syminfo.tickerid, "240", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
htf_ema_slow  = request.security(syminfo.tickerid, "240", ta.ema(close, 50), lookahead=barmerge.lookahead_off)

// ============================================================
// ░░░ FILTER ░░░
// ============================================================

// Session: stunden-basiert (robust im Backtester, kein session-string Bug)
bar_hour   = hour(time, "UTC+0")
in_session = use_session ? (bar_hour >= sess_h_start and bar_hour < sess_h_end) : true

// H4 Trend
htf_bull = use_htf ? (htf_ema_fast > htf_ema_slow and htf_close > htf_ema_slow) : true
htf_bear = use_htf ? (htf_ema_fast < htf_ema_slow and htf_close < htf_ema_slow) : true

// H1 Trend: Preis über/unter EMA200 UND EMA-Ausrichtung
h1_bull = close > ema_trend and ema_fast > ema_slow
h1_bear = close < ema_trend and ema_fast < ema_slow

// EMA Steigung (Trend muss aktiv sein, nicht flach)
slope_bull = ema_fast > ema_fast[3] and ema_slow > ema_slow[5]
slope_bear = ema_fast < ema_fast[3] and ema_slow < ema_slow[5]

// MACD: Kreuz ODER Histogram steigend/fallend
macd_xbull = ta.crossover(macd_line, sig_line)
macd_xbear = ta.crossunder(macd_line, sig_line)
macd_bull  = macd_hist > 0 and macd_hist > macd_hist[1]
macd_bear  = macd_hist < 0 and macd_hist < macd_hist[1]

// RSI Zonen (breiter für mehr Signale, aber Extremwerte ausgeschlossen)
rsi_ok_long  = rsi >= rsi_long_min  and rsi <= rsi_long_max
rsi_ok_short = rsi >= rsi_short_min and rsi <= rsi_short_max

// ADX: Trendstärke
adx_ok = use_adx ? adx_val >= adx_thresh : true

// Kerzenbestätigung: Schlusskurs bestätigt Richtung
bull_candle = close > open
bear_candle = close < open

// Pullback-Bestätigung: Preis hat sich der schnellen EMA angenähert (max 0.5×ATR Abstand)
// Verbessert Trefferquote erheblich — Einstieg nahe EMA, nicht weit weg
near_ema_long  = math.abs(close - ema_fast) < atr * 0.8 or close > ema_fast
near_ema_short = math.abs(close - ema_fast) < atr * 0.8 or close < ema_fast

// ============================================================
// ░░░ ENTRY BEDINGUNGEN ░░░
// ============================================================

long_cond = in_session
          and htf_bull
          and h1_bull
          and slope_bull
          and (macd_bull or macd_xbull)
          and rsi_ok_long
          and adx_ok
          and bull_candle
          and near_ema_long
          and strategy.position_size == 0

short_cond = in_session
           and htf_bear
           and h1_bear
           and slope_bear
           and (macd_bear or macd_xbear)
           and rsi_ok_short
           and adx_ok
           and bear_candle
           and near_ema_short
           and strategy.position_size == 0

// ============================================================
// ░░░ SL / TP PREISE BERECHNEN ░░░
// ============================================================

// Persistente Variablen — werden NUR beim Entry gesetzt
var float sl_price  = na
var float tp1_price = na
var float tp2_price = na
var int   entry_bar = na

// ============================================================
// ░░░ TRADE AUSFÜHRUNG ░░░
// ============================================================

if long_cond
    sl_price  := close - atr * sl_mult
    tp1_price := close + atr * tp1_mult
    tp2_price := close + atr * tp2_mult
    entry_bar := bar_index

    strategy.entry("Long", strategy.long, comment="▲ L")

    // Zwei saubere Exit-Orders ohne Trailing-Konflikt
    strategy.exit("L-TP1", from_entry="Long",
         qty_percent = 50,
         stop        = sl_price,
         limit       = tp1_price,
         comment_loss = "SL", comment_profit = "TP1")

    strategy.exit("L-TP2", from_entry="Long",
         qty_percent = 100,
         stop        = sl_price,
         limit       = tp2_price,
         comment_loss = "SL", comment_profit = "TP2")

    // SL/TP Linien direkt an der Einstiegskerze
    if show_lines
        line.new(bar_index, sl_price,  bar_index + line_bars, sl_price,
             color=color.new(color.red,   0), width=2, style=line.style_solid)
        line.new(bar_index, tp1_price, bar_index + line_bars, tp1_price,
             color=color.new(color.lime,  0), width=1, style=line.style_dashed)
        line.new(bar_index, tp2_price, bar_index + line_bars, tp2_price,
             color=color.new(color.green, 0), width=2, style=line.style_solid)

    if show_labels
        label.new(bar_index, low - atr * 0.4,
             text="▲ LONG", style=label.style_label_up,
             color=color.new(color.green,5), textcolor=color.white, size=size.small)

if short_cond
    sl_price  := close + atr * sl_mult
    tp1_price := close - atr * tp1_mult
    tp2_price := close - atr * tp2_mult
    entry_bar := bar_index

    strategy.entry("Short", strategy.short, comment="▼ S")

    strategy.exit("S-TP1", from_entry="Short",
         qty_percent = 50,
         stop        = sl_price,
         limit       = tp1_price,
         comment_loss = "SL", comment_profit = "TP1")

    strategy.exit("S-TP2", from_entry="Short",
         qty_percent = 100,
         stop        = sl_price,
         limit       = tp2_price,
         comment_loss = "SL", comment_profit = "TP2")

    if show_lines
        line.new(bar_index, sl_price,  bar_index + line_bars, sl_price,
             color=color.new(color.red,   0), width=2, style=line.style_solid)
        line.new(bar_index, tp1_price, bar_index + line_bars, tp1_price,
             color=color.new(color.lime,  0), width=1, style=line.style_dashed)
        line.new(bar_index, tp2_price, bar_index + line_bars, tp2_price,
             color=color.new(color.green, 0), width=2, style=line.style_solid)

    if show_labels
        label.new(bar_index, high + atr * 0.4,
             text="▼ SHORT", style=label.style_label_down,
             color=color.new(color.red,5), textcolor=color.white, size=size.small)

// EMA-Kreuz Notausstieg (Trendwechsel)
if strategy.position_size > 0 and ta.crossunder(ema_fast, ema_slow)
    strategy.close("Long", comment="EMA↓")
if strategy.position_size < 0 and ta.crossover(ema_fast, ema_slow)
    strategy.close("Short", comment="EMA↑")

// ============================================================
// ░░░ DARSTELLUNG ░░░
// ============================================================

// EMAs
plot(show_emas ? ema_fast  : na, "EMA 20",  color=color.new(color.yellow, 0), linewidth=1)
plot(show_emas ? ema_slow  : na, "EMA 50",  color=color.new(color.orange, 0), linewidth=2)
plot(show_emas ? ema_trend : na, "EMA 200", color=color.new(color.white, 35), linewidth=2)

// Laufende Position: SL/TP als Dauerlinien
plot(strategy.position_size != 0 ? sl_price  : na, "SL aktiv",  color=color.new(color.red,   20), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp1_price : na, "TP1 aktiv", color=color.new(color.lime,  20), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp2_price : na, "TP2 aktiv", color=color.new(color.green, 20), linewidth=1, style=plot.style_linebr)

// Session Hintergrund
bgcolor(in_session ? color.new(color.blue, 97) : na, title="Session aktiv")

// Trend Hintergrund
bgcolor(h1_bull and htf_bull ? color.new(color.green, 97) :
        h1_bear and htf_bear ? color.new(color.red,   97) : na, title="Trend")

// ============================================================
// ░░░ INFO TABLE ░░░
// ============================================================

var table t = table.new(position.top_right, 2, 9,
     bgcolor=color.new(color.black, 65), border_color=color.new(color.gray, 40), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "XAUUSD H1 v2", bgcolor=color.new(color.navy,40),
         text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, "",             bgcolor=color.new(color.navy,40),
         text_color=color.yellow, text_size=size.small)

    table.cell(t, 0, 1, "H4 Trend",  text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, htf_bull ? "BULL ▲" : htf_bear ? "BEAR ▼" : "–",
         text_color=htf_bull ? color.lime : htf_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(t, 0, 2, "H1 Trend",  text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, h1_bull ? "BULL ▲" : h1_bear ? "BEAR ▼" : "SEITWÄRTS",
         text_color=h1_bull ? color.lime : h1_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(t, 0, 3, "Session",   text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, in_session ? "AKTIV ✓" : "INAKTIV",
         text_color=in_session ? color.lime : color.red, text_size=size.tiny)

    table.cell(t, 0, 4, "RSI",       text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(math.round(rsi, 1)),
         text_color=rsi > 72 ? color.red : rsi < 28 ? color.lime : color.white, text_size=size.tiny)

    table.cell(t, 0, 5, "MACD",      text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, macd_bull ? "BULL ▲" : macd_bear ? "BEAR ▼" : "–",
         text_color=macd_bull ? color.lime : macd_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(t, 0, 6, "ADX",       text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6, str.tostring(math.round(adx_val,1)) + (adx_ok ? " ✓" : " ✗"),
         text_color=adx_ok ? color.lime : color.red, text_size=size.tiny)

    table.cell(t, 0, 7, "ATR",       text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 7, str.tostring(math.round(atr, 2)),
         text_color=color.white, text_size=size.tiny)

    rr = tp2_mult / sl_mult
    table.cell(t, 0, 8, "RRR TP2",   text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 8, "1 : " + str.tostring(math.round(rr, 1)),
         text_color=color.white, text_size=size.tiny)
