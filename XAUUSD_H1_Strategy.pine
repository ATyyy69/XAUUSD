// ============================================================
// XAUUSD H1 Strategie | Pine Script v5
// Kombiniert: EMA Trend + RSI + MACD + ATR + Session Filter
// Optimiert für Gold (XAUUSD) auf dem 1-Stunden-Chart
// ============================================================
//@version=5
strategy(
     title             = "XAUUSD H1 Strategy [EMA+RSI+MACD+ATR]",
     shorttitle        = "XAUUSD H1",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 2,
     commission_type   = strategy.commission.cash_per_order,
     commission_value  = 0.07,
     slippage          = 3,
     max_bars_back     = 500
     )

// ============================================================
// ░░░ EINGABEN ░░░
// ============================================================

// --- EMA Einstellungen ---
grp_ema = "EMA Einstellungen"
ema_fast_len  = input.int(20,  "Schnelle EMA",  minval=5,  maxval=50,  group=grp_ema)
ema_slow_len  = input.int(50,  "Langsame EMA",  minval=20, maxval=200, group=grp_ema)
ema_trend_len = input.int(200, "Trend EMA",     minval=50, maxval=500, group=grp_ema)

// --- RSI Einstellungen ---
grp_rsi = "RSI Einstellungen"
rsi_len         = input.int(14,  "RSI Periode",          minval=5,  maxval=30, group=grp_rsi)
rsi_long_min    = input.int(45,  "RSI Long Min",         minval=30, maxval=60, group=grp_rsi)
rsi_long_max    = input.int(65,  "RSI Long Max",         minval=50, maxval=80, group=grp_rsi)
rsi_short_min   = input.int(35,  "RSI Short Min",        minval=20, maxval=50, group=grp_rsi)
rsi_short_max   = input.int(55,  "RSI Short Max",        minval=40, maxval=70, group=grp_rsi)

// --- MACD Einstellungen ---
grp_macd = "MACD Einstellungen"
macd_fast    = input.int(12, "MACD Fast",   minval=5,  maxval=30, group=grp_macd)
macd_slow    = input.int(26, "MACD Slow",   minval=10, maxval=60, group=grp_macd)
macd_signal  = input.int(9,  "MACD Signal", minval=3,  maxval=20, group=grp_macd)

// --- ATR / Risk Management ---
grp_risk = "Risk Management"
atr_len    = input.int(14,  "ATR Periode",         minval=5,  maxval=30, group=grp_risk)
sl_mult    = input.float(1.5, "Stop-Loss ATR Mult", minval=0.5, maxval=5.0, step=0.1, group=grp_risk)
tp1_mult   = input.float(2.0, "TP1 ATR Mult (50%)", minval=1.0, maxval=10.0, step=0.1, group=grp_risk)
tp2_mult   = input.float(4.0, "TP2 ATR Mult (50%)", minval=2.0, maxval=15.0, step=0.1, group=grp_risk)
use_trail  = input.bool(true, "Trailing Stop aktivieren", group=grp_risk)
trail_mult = input.float(1.5, "Trailing ATR Mult",  minval=0.5, maxval=5.0, step=0.1, group=grp_risk)

// --- ADX Filter ---
grp_adx = "ADX Trend-Filter"
use_adx    = input.bool(true, "ADX Filter aktiv",    group=grp_adx)
adx_len    = input.int(14, "ADX Periode",             minval=7, maxval=30, group=grp_adx)
adx_thresh = input.int(22, "ADX Mindest-Schwelle",    minval=10, maxval=50, group=grp_adx)

// --- Session Filter ---
grp_sess = "Session Filter"
use_session  = input.bool(true, "Session Filter aktiv", group=grp_sess)
sess_london  = input.session("0700-1600", "London Session (UTC+0)", group=grp_sess)
sess_newyork = input.session("1300-2100", "New York Session (UTC+0)", group=grp_sess)

// --- Bollinger Bands (Volatilität) ---
grp_bb = "Bollinger Bands"
use_bb   = input.bool(true,  "BB Filter aktiv",  group=grp_bb)
bb_len   = input.int(20,     "BB Periode",        minval=10, maxval=50, group=grp_bb)
bb_mult  = input.float(2.0,  "BB Std-Abw.",       minval=1.0, maxval=4.0, step=0.1, group=grp_bb)

// --- Anzeige ---
grp_disp = "Anzeige"
show_emas     = input.bool(true, "EMAs anzeigen",             group=grp_disp)
show_bb       = input.bool(true, "Bollinger Bands anzeigen",  group=grp_disp)
show_signals  = input.bool(true, "Signal-Labels anzeigen",    group=grp_disp)

// ============================================================
// ░░░ INDIKATOREN BERECHNEN ░░░
// ============================================================

// EMAs
ema_fast  = ta.ema(close, ema_fast_len)
ema_slow  = ta.ema(close, ema_slow_len)
ema_trend = ta.ema(close, ema_trend_len)

// RSI
rsi = ta.rsi(close, rsi_len)

// MACD
[macd_line, signal_line, hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)

// ATR
atr = ta.atr(atr_len)

// Bollinger Bands
bb_basis = ta.sma(close, bb_len)
bb_dev   = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_width = (bb_upper - bb_lower) / bb_basis  // normalisierte Breite

// ADX (manuell berechnen)
[diplus, diminus, adx_val] = ta.dmi(adx_len, adx_len)

// ============================================================
// ░░░ FILTER & BEDINGUNGEN ░░░
// ============================================================

// Session-Filter
in_london   = use_session ? na(time(timeframe.period, sess_london,  "UTC+0")) == false : true
in_newyork  = use_session ? na(time(timeframe.period, sess_newyork, "UTC+0")) == false : true
in_session  = in_london or in_newyork

// Trend-Filter: Preis über/unter 200 EMA
bull_trend = close > ema_trend
bear_trend = close < ema_trend

// EMA Ausrichtung
ema_bull_align = ema_fast > ema_slow  // bullishe Ausrichtung
ema_bear_align = ema_fast < ema_slow  // bearishe Ausrichtung

// EMA Steigung (mind. 3 Bars)
ema_fast_slope_up   = ema_fast > ema_fast[3]
ema_fast_slope_down = ema_fast < ema_fast[3]
ema_slow_slope_up   = ema_slow > ema_slow[3]
ema_slow_slope_down = ema_slow < ema_slow[3]

// MACD Bedingungen
macd_bull = macd_line > signal_line and macd_line > 0
macd_bear = macd_line < signal_line and macd_line < 0
macd_cross_bull = ta.crossover(macd_line, signal_line)
macd_cross_bear = ta.crossunder(macd_line, signal_line)

// RSI Bedingungen
rsi_bull_zone = rsi >= rsi_long_min  and rsi <= rsi_long_max
rsi_bear_zone = rsi >= rsi_short_min and rsi <= rsi_short_max

// ADX Filter
adx_ok = use_adx ? adx_val >= adx_thresh : true

// Bollinger Bands Bedingungen
// Long: nicht überkauft (Preis nicht über oberem Band)
// Short: nicht überverkauft
bb_ok_long  = use_bb ? close < bb_upper * 0.999 : true
bb_ok_short = use_bb ? close > bb_lower * 1.001 : true
// Mindest-Volatilität (Band nicht zu eng)
bb_vol_ok = use_bb ? bb_width > 0.003 : true

// ============================================================
// ░░░ ENTRY BEDINGUNGEN ░░░
// ============================================================

// LONG: alle Bedingungen müssen erfüllt sein
long_cond = in_session
          and bull_trend
          and ema_bull_align
          and (ema_fast_slope_up or ema_slow_slope_up)
          and (macd_bull or macd_cross_bull)
          and rsi_bull_zone
          and adx_ok
          and bb_ok_long
          and bb_vol_ok
          and strategy.position_size == 0  // kein offener Trade

// SHORT: alle Bedingungen müssen erfüllt sein
short_cond = in_session
           and bear_trend
           and ema_bear_align
           and (ema_fast_slope_down or ema_slow_slope_down)
           and (macd_bear or macd_cross_bear)
           and rsi_bear_zone
           and adx_ok
           and bb_ok_short
           and bb_vol_ok
           and strategy.position_size == 0

// ============================================================
// ░░░ TRADE MANAGEMENT ░░░
// ============================================================

var float entry_price  = na
var float stop_loss    = na
var float take_profit1 = na
var float take_profit2 = na
var bool  tp1_reached  = false

// Entry LONG
if long_cond
    entry_price  := close
    stop_loss    := close - atr * sl_mult
    take_profit1 := close + atr * tp1_mult
    take_profit2 := close + atr * tp2_mult
    tp1_reached  := false
    strategy.entry("Long", strategy.long, comment="L")
    strategy.exit("Long SL/TP1", "Long",
         stop    = stop_loss,
         limit   = take_profit1,
         qty_percent = 50)
    strategy.exit("Long TP2", "Long",
         limit   = take_profit2,
         qty_percent = 100)

// Entry SHORT
if short_cond
    entry_price  := close
    stop_loss    := close + atr * sl_mult
    take_profit1 := close - atr * tp1_mult
    take_profit2 := close - atr * tp2_mult
    tp1_reached  := false
    strategy.entry("Short", strategy.short, comment="S")
    strategy.exit("Short SL/TP1", "Short",
         stop    = stop_loss,
         limit   = take_profit1,
         qty_percent = 50)
    strategy.exit("Short TP2", "Short",
         limit   = take_profit2,
         qty_percent = 100)

// Trailing Stop: trail_offset muss in Ticks angegeben werden (ATR / mintick)
if use_trail and strategy.position_size != 0
    trail_offset_price = atr * trail_mult
    trail_offset_ticks = trail_offset_price / syminfo.mintick
    if strategy.position_size > 0
        strategy.exit("Long Trail", "Long",
             trail_price  = high - trail_offset_price,
             trail_offset = trail_offset_ticks)
    if strategy.position_size < 0
        strategy.exit("Short Trail", "Short",
             trail_price  = low + trail_offset_price,
             trail_offset = trail_offset_ticks)

// EMA-Kreuz als Notausstieg (Trendwechsel)
exit_long_ema  = ta.crossunder(ema_fast, ema_slow) and strategy.position_size > 0
exit_short_ema = ta.crossover(ema_fast, ema_slow)  and strategy.position_size < 0

if exit_long_ema
    strategy.close("Long", comment="EMA Exit")
if exit_short_ema
    strategy.close("Short", comment="EMA Exit")

// ============================================================
// ░░░ DARSTELLUNG ░░░
// ============================================================

// EMAs plotten
plot(show_emas ? ema_fast  : na, "EMA 20",  color=color.new(color.yellow, 0),  linewidth=1)
plot(show_emas ? ema_slow  : na, "EMA 50",  color=color.new(color.orange, 0),  linewidth=2)
plot(show_emas ? ema_trend : na, "EMA 200", color=color.new(color.white,  30), linewidth=2)

// Bollinger Bands
bb_upper_plot = plot(show_bb ? bb_upper : na, "BB Upper", color=color.new(color.blue, 60), linewidth=1)
bb_lower_plot = plot(show_bb ? bb_lower : na, "BB Lower", color=color.new(color.blue, 60), linewidth=1)
fill(bb_upper_plot, bb_lower_plot, color=color.new(color.blue, 92))

// Signal-Labels
if show_signals
    if long_cond
        label.new(bar_index, low - atr * 0.5,
             text     = "▲ LONG",
             style    = label.style_label_up,
             color    = color.new(color.green, 10),
             textcolor = color.white,
             size     = size.small)
    if short_cond
        label.new(bar_index, high + atr * 0.5,
             text     = "▼ SHORT",
             style    = label.style_label_down,
             color    = color.new(color.red, 10),
             textcolor = color.white,
             size     = size.small)

// Hintergrund: Session
bgcolor(use_session and in_london  ? color.new(color.blue,  96) : na, title="London Session")
bgcolor(use_session and in_newyork ? color.new(color.green, 96) : na, title="New York Session")

// Hintergrund: Trendrichtung
bgcolor(bull_trend ? color.new(color.green, 98) : color.new(color.red, 98), title="Trend")

// SL/TP Linien für offene Positionen
plot(strategy.position_size != 0 ? stop_loss    : na, "Stop Loss",   color=color.red,    style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? take_profit1 : na, "Take Profit 1", color=color.lime, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size != 0 ? take_profit2 : na, "Take Profit 2", color=color.green, style=plot.style_linebr, linewidth=2)

// ============================================================
// ░░░ INFO TABLE ░░░
// ============================================================

var table info_table = table.new(position.top_right, 2, 8,
     bgcolor       = color.new(color.black, 70),
     border_color  = color.gray,
     border_width  = 1)

if barstate.islast
    table.cell(info_table, 0, 0, "XAUUSD H1 Strategy", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(info_table, 1, 0, "",                   text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))

    table.cell(info_table, 0, 1, "Trend",    text_color=color.gray,  text_size=size.tiny)
    table.cell(info_table, 1, 1, bull_trend ? "BULLISH ▲" : "BEARISH ▼",
         text_color = bull_trend ? color.lime : color.red, text_size=size.tiny)

    table.cell(info_table, 0, 2, "Session",  text_color=color.gray,  text_size=size.tiny)
    table.cell(info_table, 1, 2, in_session ? "AKTIV ✓" : "INAKTIV ✗",
         text_color = in_session ? color.lime : color.red, text_size=size.tiny)

    table.cell(info_table, 0, 3, "RSI",      text_color=color.gray,  text_size=size.tiny)
    table.cell(info_table, 1, 3, str.tostring(math.round(rsi, 1)),
         text_color = rsi > 70 ? color.red : rsi < 30 ? color.lime : color.white, text_size=size.tiny)

    table.cell(info_table, 0, 4, "ADX",      text_color=color.gray,  text_size=size.tiny)
    table.cell(info_table, 1, 4, str.tostring(math.round(adx_val, 1)) + (adx_ok ? " ✓" : " ✗"),
         text_color = adx_ok ? color.lime : color.red, text_size=size.tiny)

    table.cell(info_table, 0, 5, "ATR",      text_color=color.gray,  text_size=size.tiny)
    table.cell(info_table, 1, 5, str.tostring(math.round(atr, 2)),
         text_color = color.white, text_size=size.tiny)

    table.cell(info_table, 0, 6, "EMA Align", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 6, ema_bull_align ? "BULL ▲" : "BEAR ▼",
         text_color = ema_bull_align ? color.lime : color.red, text_size=size.tiny)

    table.cell(info_table, 0, 7, "MACD",     text_color=color.gray,  text_size=size.tiny)
    table.cell(info_table, 1, 7, macd_bull ? "BULL ▲" : macd_bear ? "BEAR ▼" : "NEUTRAL",
         text_color = macd_bull ? color.lime : macd_bear ? color.red : color.gray, text_size=size.tiny)
